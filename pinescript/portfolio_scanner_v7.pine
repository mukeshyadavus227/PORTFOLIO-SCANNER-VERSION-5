// ════════════════════════════════════════════════════════════════════════
// Portfolio Scanner V7 — V4 Signals + V6 Intelligence
// ════════════════════════════════════════════════════════════════════════
// Hybrid architecture: V4's proven 4-strategy signal engine generates raw
// signals, V6's evidence-weighted scoring filters and promotes the best.
//
// V4 contribution: S1-S4 signal triggers, additive scoring, event-based entries
// V6 contribution: Weekly MTF confirmation, evidence-weighted composite,
//                  regime detection, options-optimized exits, cluster presets
//
// Signal tiers:
//   PROMOTED (score >= 75): Alert fires, suitable for directional options
//   WATCHLIST (60-74):      Visual marker only, no alert
//   SUPPRESSED (< 60):     V4 would fire but V6 says conditions not aligned
// ════════════════════════════════════════════════════════════════════════

//@version=6
indicator("Portfolio Scanner V7 [Webhook]", overlay=true, max_labels_count=50)


// ════════════════════════════════════════════════════════════════════════
// SECTION 1 — MASTER CONTROLS
// ════════════════════════════════════════════════════════════════════════

minScore      = input.int(75, "Min Score (Promoted)", minval=50, maxval=95, step=5,
     group="Master Controls",
     tooltip="Score >= this fires alert. 75=production, 65=loose")
cooldownBars  = input.int(5, "Cooldown (bars)", minval=1, maxval=30,
     group="Master Controls")
longOnlyMode  = input.bool(true, "Long-Only Mode",
     group="Master Controls",
     tooltip="When ON: suppress all shorts. When OFF: shorts require score >= 85")
shortMinScore = input.int(85, "Short Min Score (if shorts enabled)", minval=70, maxval=95,
     group="Master Controls")
showDashboard = input.bool(true, "Show Dashboard",
     group="Master Controls")
showRegimeBG  = input.bool(true, "Show Regime Background",
     group="Master Controls")
webhookToken  = input.string("mukesh-tv-2026", "Webhook Token",
     group="Master Controls")

// ── Regime Detection ──
adxLen        = input.int(14, "ADX Length", minval=7, maxval=30,
     group="Regime Detection")
adxTrendThr   = input.int(25, "ADX Trend Threshold", minval=15, maxval=40,
     group="Regime Detection")
adxRangeThr   = input.int(20, "ADX Range Threshold", minval=10, maxval=25,
     group="Regime Detection")
chopLen       = input.int(14, "Choppiness Length", minval=5, maxval=30,
     group="Regime Detection")

// ── S1: RSI Mean Reversion ──
s1_rsiLen     = input.int(14, "S1: RSI Length", minval=2, maxval=50,
     group="S1: RSI Mean Reversion")
s1_oversold   = input.int(30, "S1: Oversold", minval=10, maxval=45,
     group="S1: RSI Mean Reversion")
s1_overbought = input.int(70, "S1: Overbought", minval=55, maxval=90,
     group="S1: RSI Mean Reversion")

// ── S2: Donchian Breakout ──
s2_entryLen   = input.int(20, "S2: Donchian Length", minval=5, maxval=55,
     group="S2: Donchian Breakout")
s2_trendSMA   = input.int(50, "S2: Trend SMA", minval=20, maxval=200,
     group="S2: Donchian Breakout")
s2_volMult    = input.float(1.3, "S2: Volume Spike", minval=1.0, maxval=2.0, step=0.1,
     group="S2: Donchian Breakout")

// ── S3: EMA Momentum ──
s3_fastEMA    = input.int(9, "S3: Fast EMA", minval=3, maxval=30,
     group="S3: EMA Momentum")
s3_slowEMA    = input.int(21, "S3: Slow EMA", minval=10, maxval=50,
     group="S3: EMA Momentum")
s3_trendEMA   = input.int(50, "S3: Trend EMA", minval=30, maxval=200,
     group="S3: EMA Momentum")

// ── S4: Multi-TF Trend ──
s4_wkFast     = input.int(20, "S4: Weekly Fast EMA", minval=5, maxval=50,
     group="S4: Multi-TF Trend")
s4_wkSlow     = input.int(50, "S4: Weekly Slow EMA", minval=20, maxval=100,
     group="S4: Multi-TF Trend")
s4_dailyEMA   = input.int(21, "S4: Daily Entry EMA", minval=5, maxval=50,
     group="S4: Multi-TF Trend")
s4_rsiPBLo    = input.int(40, "S4: RSI Pullback Low", minval=25, maxval=50,
     group="S4: Multi-TF Trend")
s4_rsiPBHi    = input.int(60, "S4: RSI Pullback High (Shorts)", minval=50, maxval=75,
     group="S4: Multi-TF Trend")

// ── Risk / ATR ──
atrLen        = input.int(14, "ATR Length", minval=5, maxval=30,
     group="Risk Filters")
atrMinPct     = input.float(0.8, "Min ATR % of Price", minval=0.1, maxval=3.0, step=0.1,
     group="Risk Filters")
atrMaxPct     = input.float(6.0, "Max ATR % of Price", minval=2.0, maxval=15.0, step=0.5,
     group="Risk Filters")

// ── Exit Rules ──
rsiExitHi     = input.int(80, "RSI Take Profit", minval=70, maxval=90,
     group="Exit Rules")
maxHoldBars   = input.int(20, "Max Hold Bars", minval=5, maxval=60,
     group="Exit Rules")
emaExitBars   = input.int(2, "EMA Stop Consecutive Bars", minval=1, maxval=5,
     group="Exit Rules")

// ── Ticker Cluster ──
tickerCluster = input.string("Auto-detect", "Ticker Cluster",
     options=["Trend", "Momentum", "Auto-detect"],
     group="Ticker Cluster")


// ════════════════════════════════════════════════════════════════════════
// SECTION 2 — CORE INDICATORS (V4 full set)
// ════════════════════════════════════════════════════════════════════════

// EMAs
ema9          = ta.ema(close, s3_fastEMA)
ema21         = ta.ema(close, s3_slowEMA)
ema50         = ta.ema(close, s3_trendEMA)
sma200        = ta.sma(close, 200)
ema200        = ta.ema(close, 200)
s4_dEMA       = ta.ema(close, s4_dailyEMA)

// RSI
rsi14         = ta.rsi(close, s1_rsiLen)

// ADX / DI
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)

// ATR
atr           = ta.atr(atrLen)
atrPct        = close > 0 ? atr / close * 100.0 : 0.0
atrSMA50      = ta.sma(atr, 50)
atrExpanding  = atr > atrSMA50 * 1.2

// MACD
[s3_macdL, s3_sigL, s3_hist] = ta.macd(close, 12, 26, 9)

// Volume
volSMA20      = ta.sma(volume, 20)
volAboveAvg   = volume > volSMA20 * 1.15
s2_volSpike   = volume > volSMA20 * s2_volMult

// Donchian
s2_entryHigh  = ta.highest(high, s2_entryLen)
s2_entryLow   = ta.lowest(low, s2_entryLen)

// Choppiness Index
chopATR       = math.sum(ta.tr, chopLen)
chopHL        = ta.highest(high, chopLen) - ta.lowest(low, chopLen)
chop          = chopHL != 0 ? 100.0 * math.log10(chopATR / chopHL) / math.log10(chopLen) : 50.0

// Bollinger Band Width
[bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
bbw           = bbMid != 0 ? (bbUp - bbLo) / bbMid * 100.0 : 0.0
bbwSMA        = ta.sma(bbw, 50)
bbwExpanding  = bbw > bbwSMA * 1.1
bbwContracting = bbw < bbwSMA * 0.9

// ROC
roc20         = close[20] > 0 ? (close - close[20]) / close[20] * 100.0 : 0.0
roc60         = close[60] > 0 ? (close - close[60]) / close[60] * 100.0 : 0.0

// 52-week
hi52          = ta.highest(high, 252)
lo52          = ta.lowest(low, 252)
range52       = hi52 - lo52
distFromHi    = range52 > 0 ? (hi52 - close) / range52 * 100.0 : 0.0
distFromLo    = range52 > 0 ? (close - lo52) / range52 * 100.0 : 0.0

// S3 EMA cross event (critical V4 trigger)
s3_crossUp    = ta.crossover(ema9, ema21)
s3_crossDown  = ta.crossunder(ema9, ema21)

// S3 VWAP proxy (daily chart: use SMA20)
s3_anchor     = timeframe.isintraday ? ta.vwap(hlc3) : ta.sma(close, 20)

// S4 entry triggers
s4_pullbackBuy  = rsi14 < s4_rsiPBLo and rsi14 > 25
s4_emaBounce    = close > s4_dEMA and close[1] <= s4_dEMA[1]
s4_pullbackSell = rsi14 > s4_rsiPBHi and rsi14 < 75
s4_emaReject    = close < s4_dEMA and close[1] >= s4_dEMA[1]
s4_hasLongEntry = s4_pullbackBuy or s4_emaBounce
s4_hasShortEntry = s4_pullbackSell or s4_emaReject


// ════════════════════════════════════════════════════════════════════════
// SECTION 3 — WEEKLY MULTI-TIMEFRAME (from V6, with V4 additions)
// ════════════════════════════════════════════════════════════════════════

f_adx(int len) =>
    [_p, _m, a] = ta.dmi(len, len)
    a

wkEma9        = request.security(syminfo.tickerid, "W", ta.ema(close, 9),
     barmerge.gaps_off, barmerge.lookahead_off)
wkEma21       = request.security(syminfo.tickerid, "W", ta.ema(close, 21),
     barmerge.gaps_off, barmerge.lookahead_off)
wkEma200      = request.security(syminfo.tickerid, "W", ta.ema(close, 200),
     barmerge.gaps_off, barmerge.lookahead_off)
wkClose       = request.security(syminfo.tickerid, "W", close,
     barmerge.gaps_off, barmerge.lookahead_off)
wkADX         = request.security(syminfo.tickerid, "W", f_adx(14),
     barmerge.gaps_off, barmerge.lookahead_off)

// V4's S4 weekly EMAs
s4_wkFastEMA  = request.security(syminfo.tickerid, "W", ta.ema(close, s4_wkFast),
     barmerge.gaps_off, barmerge.lookahead_off)
s4_wkSlowEMA  = request.security(syminfo.tickerid, "W", ta.ema(close, s4_wkSlow),
     barmerge.gaps_off, barmerge.lookahead_off)

// V6 weekly bullish
wkBullish     = nz(wkEma9) > nz(wkEma21) and nz(wkClose) > nz(wkEma200)
wkTrendStr    = wkBullish ? "bullish" : "neutral"

// V4 S4 weekly conditions
s4_wkBull     = nz(s4_wkFastEMA) > nz(s4_wkSlowEMA) and nz(wkClose) > nz(s4_wkFastEMA)
s4_wkBear     = nz(s4_wkFastEMA) < nz(s4_wkSlowEMA) and nz(wkClose) < nz(s4_wkFastEMA)
s4_wkStrong   = nz(wkADX) > 20


// ════════════════════════════════════════════════════════════════════════
// SECTION 4 — REGIME DETECTION (V4's 5-regime continuous scoring)
// ════════════════════════════════════════════════════════════════════════

// Continuous regime scores (0-100)
trendScore    = math.min((adxVal > adxTrendThr ? (adxVal - adxTrendThr) / 15.0 : 0.0) +
     (chop < 38.2 ? (38.2 - chop) / 20.0 : 0.0), 1.0) * 100.0
breakoutScore = math.min((atrExpanding ? 0.4 : 0.0) +
     (bbwExpanding ? 0.4 : 0.0) +
     (adxVal > adxRangeThr ? 0.2 : 0.0), 1.0) * 100.0
meanRevScore  = math.min((adxVal < adxRangeThr ? (adxRangeThr - adxVal) / 10.0 : 0.0) +
     (chop > 61.8 ? (chop - 61.8) / 20.0 : 0.0) +
     (bbwContracting ? 0.3 : 0.0), 1.0) * 100.0
momentumScore_r = math.min((adxVal > adxRangeThr and adxVal <= adxTrendThr ? 0.5 : 0.0) +
     (not bbwContracting and not bbwExpanding ? 0.3 : 0.0) +
     (math.abs(roc20) > 3.0 ? 0.2 : 0.0), 1.0) * 100.0

// Dominant regime (V4 priority: breakout > trending > momentum > meanrev > neutral)
regimeTrend    = trendScore >= 60
regimeBreakout = breakoutScore >= 60
regimeMeanRev  = meanRevScore >= 60
regimeMomentum = momentumScore_r >= 40 and not regimeBreakout and not regimeTrend and not regimeMeanRev

regime        = regimeBreakout ? 2 : regimeTrend ? 4 : regimeMomentum ? 3 : regimeMeanRev ? 1 : 0
regimeStr     = regime == 1 ? "MEAN_REV" : regime == 2 ? "BREAKOUT" : regime == 3 ? "MOMENTUM" : regime == 4 ? "TRENDING" : "NEUTRAL"
regimeConf    = regime == 1 ? meanRevScore : regime == 2 ? breakoutScore : regime == 3 ? momentumScore_r : regime == 4 ? trendScore : 0.0

// Background
regimeColor   = regime == 4 ? color.new(color.green, 93) : regime == 2 ? color.new(color.yellow, 93) : regime == 3 ? color.new(color.blue, 93) : regime == 1 ? color.new(color.purple, 93) : color.new(color.gray, 96)
bgcolor(showRegimeBG ? regimeColor : na, title="Regime BG")

// Cluster auto-detection
adxAvg50      = ta.sma(adxVal, 50)
autoCluster   = adxAvg50 > 22 ? "Momentum" : "Trend"
activeCluster = tickerCluster == "Auto-detect" ? autoCluster : tickerCluster

// Regime-strategy alignment (V4 relaxed gates)
s1_aligned    = regime == 1 or regime == 0 or regime == 3
s2_aligned    = regime == 2 or regime == 0 or regime == 4
s3_aligned    = regime == 3 or regime == 0 or regime == 4 or regime == 2
s4_aligned    = regime == 4 or regime == 0 or regime == 3


// ════════════════════════════════════════════════════════════════════════
// SECTION 5 — V4 RAW SIGNAL SCORING (S1-S4)
// ════════════════════════════════════════════════════════════════════════

// ── S1: RSI Mean Reversion ──
s1_rsiScore   = rsi14 < s1_oversold - 10 ? 35.0 :
     rsi14 < s1_oversold - 5 ? 30.0 :
     rsi14 < s1_oversold ? 25.0 :
     rsi14 < s1_oversold + 5 ? 12.0 : 0.0
s1_rsiScoreS  = rsi14 > s1_overbought + 10 ? 35.0 :
     rsi14 > s1_overbought + 5 ? 30.0 :
     rsi14 > s1_overbought ? 25.0 :
     rsi14 > s1_overbought - 5 ? 12.0 : 0.0

s1_wkTrend    = request.security(syminfo.tickerid, "W", ta.sma(close, 50),
     barmerge.gaps_off, barmerge.lookahead_off)
s1_trendUp    = close > nz(s1_wkTrend) and close > sma200
s1_trendDn    = close < nz(s1_wkTrend) and close < sma200
s1_deepOS     = rsi14 < s1_oversold - 5
s1_deepOB     = rsi14 > s1_overbought + 5

s1_scoreLong  = s1_rsiScore +
     (s1_trendUp ? 25.0 : close > sma200 ? 15.0 : s1_deepOS ? 12.0 : 0.0) +
     (volAboveAvg ? 15.0 : 0.0) +
     (distFromHi > 50 ? 10.0 : distFromHi > 30 ? 5.0 : 0.0) +
     (regimeMeanRev ? 15.0 : regime == 0 ? 8.0 : 0.0)
s1_scoreShort = s1_rsiScoreS +
     (s1_trendDn ? 25.0 : close < sma200 ? 15.0 : s1_deepOB ? 12.0 : 0.0) +
     (volAboveAvg ? 15.0 : 0.0) +
     (distFromLo > 50 ? 10.0 : distFromLo > 30 ? 5.0 : 0.0) +
     (regimeMeanRev ? 15.0 : regime == 0 ? 8.0 : 0.0)

// ── S2: Donchian Breakout ──
s2_sma        = ta.sma(close, s2_trendSMA)
s2_breakHi    = close > s2_entryHigh[1]
s2_breakLo    = close < s2_entryLow[1]
s2_extUp      = close > s2_sma + atr * 1.5
s2_extDn      = close < s2_sma - atr * 1.5
s2_hasVol     = s2_volSpike or volAboveAvg

s2_scoreLong  = (not s2_breakHi or s2_extUp or not s2_hasVol) ? 0.0 :
     30.0 +
     (close > s2_sma ? 15.0 : 0.0) +
     (adxVal > adxTrendThr ? 15.0 : adxVal > adxRangeThr ? 8.0 : 0.0) +
     (s2_volSpike ? 20.0 : 10.0) +
     (atrExpanding ? 5.0 : 0.0) +
     (regimeBreakout ? 15.0 : regime == 4 ? 8.0 : regime == 0 ? 5.0 : 0.0)
s2_scoreShort = (not s2_breakLo or s2_extDn or not s2_hasVol) ? 0.0 :
     30.0 +
     (close < s2_sma ? 15.0 : 0.0) +
     (adxVal > adxTrendThr ? 15.0 : adxVal > adxRangeThr ? 8.0 : 0.0) +
     (s2_volSpike ? 20.0 : 10.0) +
     (atrExpanding ? 5.0 : 0.0) +
     (regimeBreakout ? 15.0 : regime == 4 ? 8.0 : regime == 0 ? 5.0 : 0.0)

// ── S3: EMA/VWAP Momentum ──
s3_longBlocked  = rsi14 > 70
s3_shortBlocked = rsi14 < 30
s3_barsSinceCU  = ta.barssince(s3_crossUp)
s3_barsSinceCD  = ta.barssince(s3_crossDown)
s3_recentUp     = not na(s3_barsSinceCU) and s3_barsSinceCU <= 5
s3_recentDn     = not na(s3_barsSinceCD) and s3_barsSinceCD <= 5

s3_scoreLong  = (s3_longBlocked or not s3_recentUp) ? 0.0 :
     (s3_crossUp ? 25.0 : ema9 > ema21 ? 10.0 : 0.0) +
     (close > s3_anchor ? 15.0 : 0.0) +
     (close > ema50 ? 12.0 : 0.0) +
     (s3_hist > 0 and rsi14 > 50 ? 15.0 : s3_hist > 0 ? 8.0 : 0.0) +
     (volAboveAvg ? 10.0 : 0.0) +
     (roc20 > 3.0 ? 8.0 : 0.0) +
     (regimeMomentum ? 15.0 : regime == 4 ? 10.0 : regime == 2 ? 8.0 : regime == 0 ? 5.0 : 0.0)
s3_scoreShort = (s3_shortBlocked or not s3_recentDn) ? 0.0 :
     (s3_crossDown ? 25.0 : ema9 < ema21 ? 10.0 : 0.0) +
     (close < s3_anchor ? 15.0 : 0.0) +
     (close < ema50 ? 12.0 : 0.0) +
     (s3_hist < 0 and rsi14 < 50 ? 15.0 : s3_hist < 0 ? 8.0 : 0.0) +
     (volAboveAvg ? 10.0 : 0.0) +
     (roc20 < -3.0 ? 8.0 : 0.0) +
     (regimeMomentum ? 15.0 : regime == 4 ? 10.0 : regime == 2 ? 8.0 : regime == 0 ? 5.0 : 0.0)

// ── S4: Multi-TF Trend ──
s4_scoreLong  = not s4_hasLongEntry ? 0.0 :
     (s4_wkBull ? 25.0 : 0.0) +
     (s4_wkStrong ? 10.0 : 0.0) +
     (s4_pullbackBuy ? 20.0 : s4_emaBounce ? 15.0 : 0.0) +
     (s3_macdL > s3_sigL ? 8.0 : 0.0) +
     (close > sma200 ? 8.0 : 0.0) +
     (volAboveAvg ? 7.0 : 0.0) +
     (roc60 > 5.0 ? 7.0 : 0.0) +
     (regimeTrend ? 15.0 : regime == 3 ? 10.0 : regime == 0 ? 5.0 : 0.0)
s4_scoreShort = not s4_hasShortEntry ? 0.0 :
     (s4_wkBear ? 25.0 : 0.0) +
     (s4_wkStrong ? 10.0 : 0.0) +
     (s4_pullbackSell ? 20.0 : s4_emaReject ? 15.0 : 0.0) +
     (s3_macdL < s3_sigL ? 8.0 : 0.0) +
     (close < sma200 ? 8.0 : 0.0) +
     (volAboveAvg ? 7.0 : 0.0) +
     (roc60 < -5.0 ? 7.0 : 0.0) +
     (regimeTrend ? 15.0 : regime == 3 ? 10.0 : regime == 0 ? 5.0 : 0.0)


// ════════════════════════════════════════════════════════════════════════
// SECTION 6 — V4 WINNER SELECTION
// ════════════════════════════════════════════════════════════════════════

// Apply regime alignment gates
s1_fL = s1_aligned ? s1_scoreLong  : 0.0
s2_fL = s2_aligned ? s2_scoreLong  : 0.0
s3_fL = s3_aligned ? s3_scoreLong  : 0.0
s4_fL = s4_aligned ? s4_scoreLong  : 0.0
s1_fS = s1_aligned ? s1_scoreShort : 0.0
s2_fS = s2_aligned ? s2_scoreShort : 0.0
s3_fS = s3_aligned ? s3_scoreShort : 0.0
s4_fS = s4_aligned ? s4_scoreShort : 0.0

// Best long/short (V4 tie-break: S1 > S2 > S3 > S4)
v4_bestLong   = math.max(s1_fL, math.max(s2_fL, math.max(s3_fL, s4_fL)))
v4_bestLStrat = v4_bestLong == s1_fL and s1_fL > 0 ? 1 :
     v4_bestLong == s2_fL and s2_fL > 0 ? 2 :
     v4_bestLong == s3_fL and s3_fL > 0 ? 3 :
     v4_bestLong == s4_fL and s4_fL > 0 ? 4 : 0
v4_bestShort  = math.max(s1_fS, math.max(s2_fS, math.max(s3_fS, s4_fS)))
v4_bestSStrat = v4_bestShort == s1_fS and s1_fS > 0 ? 1 :
     v4_bestShort == s2_fS and s2_fS > 0 ? 2 :
     v4_bestShort == s3_fS and s3_fS > 0 ? 3 :
     v4_bestShort == s4_fS and s4_fS > 0 ? 4 : 0

v4_rawScore   = math.max(v4_bestLong, v4_bestShort)
v4_rawStrat   = v4_bestLong >= v4_bestShort ? v4_bestLStrat : v4_bestSStrat
v4_rawDir     = v4_bestLong >= v4_bestShort ? "BUY" : "SELL"
v4_hasSignal  = v4_rawScore > 0 and v4_rawStrat > 0

stratName(_id) =>
    _id == 1 ? "RSI_MeanRev" : _id == 2 ? "Donchian_Break" : _id == 3 ? "EMA_Momentum" : _id == 4 ? "MTF_Trend" : "None"


// ════════════════════════════════════════════════════════════════════════
// SECTION 7 — V6 EVIDENCE-WEIGHTED COMPOSITE (layered on V4 signal)
// ════════════════════════════════════════════════════════════════════════

// Only compute composite when V4 has a raw signal
v6_composite  = 0.0
if v4_hasSignal
    dirMult   = v4_rawDir == "BUY" ? 1.0 : -1.0

    // EMA9 > EMA21 alignment: +25 (strongest predictor)
    emaAligned = (dirMult > 0 and ema9 > ema21) or (dirMult < 0 and ema9 < ema21)

    // RSI direction: +25
    rsiAligned = (dirMult > 0 and rsi14 > 50) or (dirMult < 0 and rsi14 < 50)

    // Close vs EMA200: +20
    ema200Aligned = (dirMult > 0 and close > ema200) or (dirMult < 0 and close < ema200)

    // Weekly trend: +15
    wkAligned  = (dirMult > 0 and wkBullish) or (dirMult < 0 and not wkBullish)

    // Volume above avg: +5
    volOk      = volAboveAvg

    // MACD direction: +5
    macdAligned = (dirMult > 0 and s3_hist > 0) or (dirMult < 0 and s3_hist < 0)

    // ADX + regime: +5
    adxOk      = adxVal > adxTrendThr

    v6_composite := (emaAligned ? 25.0 : 0.0) +
         (rsiAligned ? 25.0 : 0.0) +
         (ema200Aligned ? 20.0 : 0.0) +
         (wkAligned ? 15.0 : 0.0) +
         (volOk ? 5.0 : 0.0) +
         (macdAligned ? 5.0 : 0.0) +
         (adxOk ? 5.0 : 0.0)


// ════════════════════════════════════════════════════════════════════════
// SECTION 8 — SIGNAL TIER CLASSIFICATION + FILTERS
// ════════════════════════════════════════════════════════════════════════

// Long-only filtering
dirOk         = v4_rawDir == "BUY" or (not longOnlyMode and v4_rawDir == "SELL")
shortScoreOk  = v4_rawDir == "BUY" or v6_composite >= shortMinScore

// ATR range filter
atrInRange    = atrPct >= atrMinPct and atrPct <= atrMaxPct

// Cooldown
var int lastSignalBar = 0
cooldownOk    = bar_index - lastSignalBar >= cooldownBars

// Fire or not — simple
isPromoted    = v4_hasSignal and v6_composite >= minScore and dirOk and shortScoreOk and atrInRange and cooldownOk and barstate.isconfirmed
bestAction    = v4_rawDir == "BUY" ? "LONG_ENTRY" : "SHORT_ENTRY"
optionsGuide  = v4_rawStrat == 2 ? "breakout_long" :
     v4_rawStrat == 1 ? "sell_premium" : "directional_long"


// ════════════════════════════════════════════════════════════════════════
// SECTION 9 — EXIT SIGNALS
// ════════════════════════════════════════════════════════════════════════

var int entryBar    = 0
var bool inPosition = false

closeBelowExit      = close < s4_dEMA
var int belowCount  = 0
belowCount         := closeBelowExit ? belowCount + 1 : 0
exitStop            = inPosition and belowCount >= emaExitBars

exitTP              = inPosition and rsi14 > rsiExitHi
barsInTrade         = inPosition ? bar_index - entryBar : 0
exitTime            = inPosition and barsInTrade >= maxHoldBars

// Regime deterioration: trending/momentum → mean_rev or neutral with low confidence
exitRegime          = inPosition and regime == 1 and regimeConf > 60

exitSignal          = exitStop or exitTP or exitTime or exitRegime
exitReason          = exitStop ? "stop_loss" : exitTP ? "take_profit" :
     exitTime ? "time_stop" : exitRegime ? "regime_change" : ""


// ════════════════════════════════════════════════════════════════════════
// SECTION 10 — POSITION TRACKING + SIGNAL FIRE
// ════════════════════════════════════════════════════════════════════════

if isPromoted
    lastSignalBar := bar_index
    entryBar      := bar_index
    inPosition    := true
    belowCount    := 0

if exitSignal
    inPosition    := false
    entryBar      := 0
    belowCount    := 0


// ════════════════════════════════════════════════════════════════════════
// SECTION 11 — VISUAL MARKERS
// ════════════════════════════════════════════════════════════════════════

// Key indicator plots
plot(sma200, "SMA 200", color=color.gray, linewidth=1)
plot(ema9, "EMA Fast", color=color.new(color.blue, 40), linewidth=1)
plot(ema21, "EMA Slow", color=color.new(color.orange, 40), linewidth=1)
plot(s2_entryHigh, "DC High", color=color.new(color.green, 70), linewidth=1)
plot(s2_entryLow, "DC Low", color=color.new(color.red, 70), linewidth=1)

// ── PROMOTED signals (large markers, alert fires) ──
// ── LONG ENTRY (alert fires) ──
plotshape(isPromoted and v4_rawDir == "BUY", "Long Entry",
     shape.triangleup, location.belowbar, color=color.green, size=size.normal)

// ── SHORT ENTRY (alert fires, only when long-only mode is OFF) ──
plotshape(isPromoted and v4_rawDir == "SELL", "Short Entry",
     shape.triangledown, location.abovebar, color=color.red, size=size.normal)

// ── EXIT signal ──
plotshape(exitSignal, "Exit", shape.xcross, location.abovebar,
     color=color.red, size=size.small)


// ════════════════════════════════════════════════════════════════════════
// SECTION 12 — DASHBOARD TABLE
// ════════════════════════════════════════════════════════════════════════

var tbl = table.new(position.top_right, 4, 13,
     border_color=color.gray, border_width=1,
     frame_color=color.gray, frame_width=2)

daysSinceSignal = bar_index - lastSignalBar

if barstate.islast and showDashboard
    // Row 0: Header
    table.cell(tbl, 0, 0, syminfo.ticker,
         bgcolor=color.black, text_color=color.white, text_size=size.normal)
    table.cell(tbl, 1, 0, "V7",
         bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 2, 0, activeCluster,
         bgcolor=color.navy, text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 3, 0, "Score",
         bgcolor=color.black, text_color=color.white, text_size=size.small)

    // Row 1: Regime
    regClr = regime == 4 ? color.green : regime == 2 ? color.yellow :
         regime == 3 ? color.blue : regime == 1 ? color.purple : color.gray
    table.cell(tbl, 0, 1, "REGIME",
         bgcolor=color.maroon, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, regimeStr,
         text_color=regClr, text_size=size.small)
    table.cell(tbl, 2, 1, str.tostring(regimeConf, "#"),
         text_color=regClr, text_size=size.small)
    table.cell(tbl, 3, 1, "ADX=" + str.tostring(adxVal, "#") + " CH=" + str.tostring(chop, "#"),
         text_color=color.white, text_size=size.tiny)

    // Row 2-5: S1-S4 strategy scores
    s1_b = math.max(s1_fL, s1_fS)
    s2_b = math.max(s2_fL, s2_fS)
    s3_b = math.max(s3_fL, s3_fS)
    s4_b = math.max(s4_fL, s4_fS)
    table.cell(tbl, 0, 2, "S1 MR",
         bgcolor=color.new(color.purple, 50), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, s1_fL > s1_fS ? "LONG" : s1_fS > 0 ? "SHORT" : "—",
         text_color=s1_fL > s1_fS ? color.green : s1_fS > 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 2, 2, str.tostring(s1_b, "#"),
         text_color=s1_b >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 2, s1_aligned ? "OK" : "BLOCKED",
         text_color=s1_aligned ? color.green : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 3, "S2 BRK",
         bgcolor=color.new(color.yellow, 50), text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 3, s2_fL > s2_fS ? "LONG" : s2_fS > 0 ? "SHORT" : "—",
         text_color=s2_fL > s2_fS ? color.green : s2_fS > 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 2, 3, str.tostring(s2_b, "#"),
         text_color=s2_b >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 3, s2_aligned ? "OK" : "BLOCKED",
         text_color=s2_aligned ? color.green : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 4, "S3 MOM",
         bgcolor=color.new(color.blue, 50), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4, s3_fL > s3_fS ? "LONG" : s3_fS > 0 ? "SHORT" : "—",
         text_color=s3_fL > s3_fS ? color.green : s3_fS > 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 2, 4, str.tostring(s3_b, "#"),
         text_color=s3_b >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 4, s3_aligned ? "OK" : "BLOCKED",
         text_color=s3_aligned ? color.green : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 5, "S4 MTF",
         bgcolor=color.new(color.teal, 50), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 5, s4_fL > s4_fS ? "LONG" : s4_fS > 0 ? "SHORT" : "—",
         text_color=s4_fL > s4_fS ? color.green : s4_fS > 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 2, 5, str.tostring(s4_b, "#"),
         text_color=s4_b >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 5, s4_aligned ? "OK" : "BLOCKED",
         text_color=s4_aligned ? color.green : color.red, text_size=size.tiny)

    // Row 6: separator
    table.cell(tbl, 0, 6, "", bgcolor=color.black)
    table.cell(tbl, 1, 6, "", bgcolor=color.black)
    table.cell(tbl, 2, 6, "", bgcolor=color.black)
    table.cell(tbl, 3, 6, "", bgcolor=color.black)

    // Row 7: V4 Raw Signal
    table.cell(tbl, 0, 7, "V4 RAW",
         bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 7, v4_hasSignal ? stratName(v4_rawStrat) + " " + v4_rawDir : "—",
         text_color=v4_hasSignal ? (v4_rawDir == "BUY" ? color.green : color.red) : color.gray,
         text_size=size.small)
    table.cell(tbl, 2, 7, str.tostring(v4_rawScore, "#"),
         text_color=v4_rawScore >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 7, v4_hasSignal ? "ACTIVE" : "—",
         text_color=v4_hasSignal ? color.yellow : color.gray, text_size=size.tiny)

    // Row 8: V6 Composite Score
    table.cell(tbl, 0, 8, "V6 COMP",
         bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 8, str.tostring(v6_composite, "0.#"),
         text_color=v6_composite >= minScore ? color.green :
              v6_composite >= watchlistScore ? color.yellow : color.gray, text_size=size.small)
    table.cell(tbl, 2, 8, "", text_size=size.small)
    table.cell(tbl, 3, 8, "max 100",
         text_color=color.gray, text_size=size.tiny)

    // Row 9: Signal status
    table.cell(tbl, 0, 9, "SIGNAL",
         bgcolor=color.new(color.teal, 40), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 9, isPromoted ? "FIRE" : v4_hasSignal ? "BLOCKED" : "—",
         text_color=isPromoted ? color.green : v4_hasSignal ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 2, 9, isPromoted ? v4_rawDir : "—",
         text_color=isPromoted ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 9, cooldownOk ? "CD OK" : "CD " + str.tostring(cooldownBars - (bar_index - lastSignalBar)),
         text_color=cooldownOk ? color.green : color.red, text_size=size.tiny)

    // Row 10: Weekly + signal info
    table.cell(tbl, 0, 10, "WEEKLY",
         bgcolor=color.new(color.teal, 60), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 10, wkTrendStr,
         text_color=wkBullish ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 2, 10, str.tostring(daysSinceSignal) + " bars ago",
         text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 3, 10, inPosition ? "IN TRADE " + str.tostring(barsInTrade) + "b" : "FLAT",
         text_color=inPosition ? color.yellow : color.gray, text_size=size.tiny)

    // Row 11: RSI + ATR
    table.cell(tbl, 0, 11, "RSI/ATR",
         bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 11, "RSI=" + str.tostring(rsi14, "0.#"),
         text_color=rsi14 < 30 ? color.green : rsi14 > 70 ? color.red : color.white, text_size=size.small)
    table.cell(tbl, 2, 11, str.tostring(atrPct, "0.#") + "%",
         text_color=atrInRange ? color.green : color.red, text_size=size.small)
    table.cell(tbl, 3, 11, longOnlyMode ? "LONG ONLY" : "L+S",
         text_color=longOnlyMode ? color.yellow : color.white, text_size=size.tiny)

    // Row 12: version
    table.cell(tbl, 0, 12, "", bgcolor=color.black)
    table.cell(tbl, 1, 12, "", bgcolor=color.black)
    table.cell(tbl, 2, 12, "TF=" + timeframe.period,
         text_color=color.gray, text_size=size.tiny, bgcolor=color.black)
    table.cell(tbl, 3, 12, "v7.0",
         text_color=color.gray, text_size=size.tiny, bgcolor=color.black)


// ════════════════════════════════════════════════════════════════════════
// SECTION 13 — ALERT CONDITIONS
// ════════════════════════════════════════════════════════════════════════

alertcondition(isPromoted and v4_rawDir == "BUY",
     title="V7: Promoted Long",
     message="V7 PROMOTED LONG on {{ticker}}")
alertcondition(isPromoted and v4_rawDir == "BUY" and v4_rawStrat == 2,
     title="V7: Promoted Breakout",
     message="V7 BREAKOUT LONG on {{ticker}}")
alertcondition(isPromoted and v4_rawDir == "SELL",
     title="V7: Promoted Short",
     message="V7 PROMOTED SHORT on {{ticker}}")
alertcondition(exitSignal,
     title="V7: Exit",
     message="V7 EXIT on {{ticker}}")


// ════════════════════════════════════════════════════════════════════════
// SECTION 14 — WEBHOOK JSON PAYLOAD
// ════════════════════════════════════════════════════════════════════════

// Strategy-specific stop/TP (from V4)
s1_stop = atr * 1.2
s1_tp   = atr * 2.5
s2_stop = math.max(atr * 0.8, math.abs(close - s2_entryHigh[1]) + atr * 0.3)
s2_tp   = atr * 3.0
s3_stop = atr * 1.8
s3_tp   = atr * 3.0
s4_stop = atr * 2.5
s4_tp   = atr * 4.0
suggestedStop = v4_rawStrat == 1 ? s1_stop : v4_rawStrat == 2 ? s2_stop :
     v4_rawStrat == 3 ? s3_stop : v4_rawStrat == 4 ? s4_stop : atr * 2.0
suggestedTP   = v4_rawStrat == 1 ? s1_tp : v4_rawStrat == 2 ? s2_tp :
     v4_rawStrat == 3 ? s3_tp : v4_rawStrat == 4 ? s4_tp : atr * 3.0
stopPrice     = v4_rawDir == "BUY" ? close - suggestedStop : close + suggestedStop
tpPrice       = v4_rawDir == "BUY" ? close + suggestedTP : close - suggestedTP
rrRatio       = suggestedStop > 0 ? suggestedTP / suggestedStop : 0.0

if isPromoted
    safeTicker = str.replace_all(syminfo.ticker, '"', '\\"')
    safeToken  = str.replace_all(webhookToken, '"', '\\"')

    payload = '{' +
         '"token":"' + safeToken + '",' +
         '"ticker":"' + safeTicker + '",' +
         '"action":"' + bestAction + '",' +
         '"strategy":"' + stratName(v4_rawStrat) + '",' +
         '"v4_score":' + str.tostring(v4_rawScore, "0.#") + ',' +
         '"v6_composite":' + str.tostring(v6_composite, "0.#") + ',' +
         '"sec_type":"OPT",' +
         '"regime":"' + regimeStr + '",' +
         '"regime_conf":' + str.tostring(regimeConf, "0.#") + ',' +
         '"entry_price":' + str.tostring(close, "0.##") + ',' +
         '"stop_price":' + str.tostring(stopPrice, "0.##") + ',' +
         '"tp_price":' + str.tostring(tpPrice, "0.##") + ',' +
         '"rr_ratio":' + str.tostring(rrRatio, "0.#") + ',' +
         '"atr":' + str.tostring(atr, "0.##") + ',' +
         '"rsi":' + str.tostring(rsi14, "0.#") + ',' +
         '"adx":' + str.tostring(adxVal, "0.#") + ',' +
         '"weekly_trend":"' + wkTrendStr + '",' +
         '"cluster":"' + activeCluster + '",' +
         '"options_guidance":"' + optionsGuide + '",' +
         '"long_only":' + (longOnlyMode ? "true" : "false") + ',' +
         '"timeframe":"' + timeframe.period + '",' +
         '"bar_time":' + str.tostring(time) +
         '}'

    alert(payload, alert.freq_once_per_bar_close)

if exitSignal
    safeTicker2 = str.replace_all(syminfo.ticker, '"', '\\"')
    safeToken2  = str.replace_all(webhookToken, '"', '\\"')

    exitPayload = '{' +
         '"token":"' + safeToken2 + '",' +
         '"ticker":"' + safeTicker2 + '",' +
         '"action":"EXIT",' +
         '"exit_reason":"' + exitReason + '",' +
         '"bars_in_trade":' + str.tostring(barsInTrade) + ',' +
         '"regime":"' + regimeStr + '",' +
         '"rsi":' + str.tostring(rsi14, "0.#") + ',' +
         '"bar_time":' + str.tostring(time) +
         '}'

    alert(exitPayload, alert.freq_once_per_bar_close)
