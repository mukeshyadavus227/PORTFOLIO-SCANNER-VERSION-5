// ════════════════════════════════════════════════════════════════════════
// Swing Options V2 — Hybrid Timeframe: Daily Qualification + Intraday Timing
// ════════════════════════════════════════════════════════════════════════
// 3-Layer Architecture:
//   Layer 1 — WEEKLY (request.security "W"): Regime direction (bull/bear/range)
//   Layer 2 — DAILY  (request.security "D"): Signal QUALIFICATION
//   Layer 3 — INTRADAY (native 4h/6h):      Entry TIMING (fires in PM session)
//
// Deploy on 4h or 6h chart. Signals fire in afternoon session for bot execution.
// Daily qualification preserves backtest validity. Intraday timing enables real-time.
//
// NOTE: Intraday timing layer is approximate — validated with daily proxy.
// Fine-tune during first 2 weeks of paper trading.
// ════════════════════════════════════════════════════════════════════════

//@version=6
indicator("Swing Options V2 [Webhook]", overlay=true, max_labels_count=50)


// ════════════════════════════════════════════════════════════════════════
// INPUTS
// ════════════════════════════════════════════════════════════════════════

minScore      = input.int(70, "Min Conviction Score", minval=40, maxval=95, step=5, group="Master Controls")
cooldownBars  = input.int(5, "Cooldown Bars", minval=1, maxval=20, group="Master Controls")
showDashboard = input.bool(true, "Show Dashboard", group="Master Controls")
showRegimeBG  = input.bool(true, "Show Regime Background", group="Master Controls")
webhookToken  = input.string("mukesh-tv-2026", "Webhook Token", group="Master Controls")
pmSessionOnly = input.bool(true, "PM Session Signals Only", group="Master Controls", tooltip="Only fire signals after 12:00 ET for bot execution timing")

dirOverride   = input.string("Auto", "Direction Override", options=["Auto", "Long Only", "Short Only", "Both"], group="Override")
archOverride  = input.string("Auto", "Archetype Override", options=["Auto", "Trend Pullback", "Momentum Breakout", "Mean Reversion"], group="Override")

rsiExitHi     = input.int(80, "RSI Take Profit", minval=70, maxval=90, group="Exit Rules")
timeWarnBar   = input.int(15, "Time Warning Bar", minval=10, maxval=25, group="Exit Rules")


// ════════════════════════════════════════════════════════════════════════
// PER-TICKER CONFIG (archId: 1=trend_pullback 2=momentum_breakout 3=mean_reversion)
// ════════════════════════════════════════════════════════════════════════

f_arch() =>
    t = syminfo.ticker
    t == "GLD" ? 1 : t == "TSLA" ? 1 : t == "AMD" ? 1 : t == "MSFT" ? 1 : t == "AMZN" ? 1 : t == "SOFI" ? 1 : t == "QQQ" ? 1 : t == "SLV" ? 2 : t == "XLE" ? 2 : t == "SPY" ? 2 : t == "IWM" ? 2 : t == "NVDA" ? 2 : t == "INTC" ? 2 : t == "XLF" ? 3 : t == "META" ? 3 : 1

f_dir() =>
    t = syminfo.ticker
    t == "SPY" ? 4 : t == "IWM" ? 4 : t == "QQQ" ? 4 : t == "AMD" ? 3 : t == "MSFT" ? 3 : t == "INTC" ? 2 : t == "META" ? 1 : 1

f_atrStop() =>
    t = syminfo.ticker
    t == "GLD" ? 3.0 : t == "SLV" ? 3.0 : t == "TSLA" ? 3.0 : t == "AMD" ? 3.0 : t == "MSFT" ? 3.0 : t == "SPY" ? 3.0 : t == "QQQ" ? 3.0 : t == "IWM" ? 3.0 : t == "XLE" ? 2.0 : 1.5

f_atrTarget() =>
    t = syminfo.ticker
    t == "TSLA" ? 2.0 : t == "MSFT" ? 2.0 : t == "XLF" ? 2.0 : t == "META" ? 2.0 : 1.5

f_maxHold() =>
    t = syminfo.ticker
    t == "GLD" ? 40 : t == "SLV" ? 40 : t == "TSLA" ? 40 : t == "MSFT" ? 40 : t == "XLF" ? 40 : t == "META" ? 40 : 30

f_hasIC() =>
    t = syminfo.ticker
    t == "SPY" or t == "QQQ" or t == "IWM" or t == "AMZN" or t == "INTC"

rawArchId     = archOverride == "Trend Pullback" ? 1 : archOverride == "Momentum Breakout" ? 2 : archOverride == "Mean Reversion" ? 3 : f_arch()
rawDirId      = dirOverride == "Long Only" ? 1 : dirOverride == "Short Only" ? 2 : dirOverride == "Both" ? 3 : f_dir()
atrStopMult   = f_atrStop()
atrTargetMult = f_atrTarget()
maxHoldBars   = f_maxHold()
hasIronCondor = f_hasIC()
isRegimeAdaptive = rawDirId == 4
isMeta        = syminfo.ticker == "META"
archName      = rawArchId == 1 ? "trend_pullback" : rawArchId == 2 ? "momentum_breakout" : "mean_reversion"
dirName       = rawDirId == 1 ? "long_only" : rawDirId == 2 ? "short_only" : rawDirId == 3 ? "both" : "regime_adaptive"


// ════════════════════════════════════════════════════════════════════════
// LAYER 1 — WEEKLY REGIME (request.security "W")
// ════════════════════════════════════════════════════════════════════════

f_wkAdx(int len) =>
    [_p, _m, a] = ta.dmi(len, len)
    a

wkEma9    = request.security(syminfo.tickerid, "W", ta.ema(close, 9), barmerge.gaps_off, barmerge.lookahead_off)
wkEma21   = request.security(syminfo.tickerid, "W", ta.ema(close, 21), barmerge.gaps_off, barmerge.lookahead_off)
wkADX     = request.security(syminfo.tickerid, "W", f_wkAdx(14), barmerge.gaps_off, barmerge.lookahead_off)

wkBullish  = nz(wkEma9) > nz(wkEma21)
wkBearish  = nz(wkEma9) < nz(wkEma21)
regimeState = isRegimeAdaptive ? (wkBullish ? "bull" : "bear") : "n/a"

longAllowed  = rawDirId == 1 or rawDirId == 3 or (rawDirId == 4 and wkBullish)
shortAllowed = rawDirId == 2 or rawDirId == 3 or (rawDirId == 4 and wkBearish)


// ════════════════════════════════════════════════════════════════════════
// LAYER 2 — DAILY SIGNAL QUALIFICATION (request.security "D")
// ════════════════════════════════════════════════════════════════════════

// Daily indicators via request.security — uses YESTERDAY's completed data [1]
f_dlyMacdH() =>
    [_l, _s, h] = ta.macd(close, 12, 26, 9)
    h

f_dlyBbLo() =>
    [_m, _u, l] = ta.bb(close, 20, 2.0)
    l

f_dlyBbMid() =>
    [m, _u, _l] = ta.bb(close, 20, 2.0)
    m

f_dlyBbUp() =>
    [_m, u, _l] = ta.bb(close, 20, 2.0)
    u

dlyEma9    = request.security(syminfo.tickerid, "D", ta.ema(close, 9), barmerge.gaps_off, barmerge.lookahead_off)
dlyEma21   = request.security(syminfo.tickerid, "D", ta.ema(close, 21), barmerge.gaps_off, barmerge.lookahead_off)
dlyRsi     = request.security(syminfo.tickerid, "D", ta.rsi(close, 14), barmerge.gaps_off, barmerge.lookahead_off)
dlyMacdH   = request.security(syminfo.tickerid, "D", f_dlyMacdH(), barmerge.gaps_off, barmerge.lookahead_off)
dlyDonchHi = request.security(syminfo.tickerid, "D", ta.highest(high, 20), barmerge.gaps_off, barmerge.lookahead_off)
dlyDonchLo = request.security(syminfo.tickerid, "D", ta.lowest(low, 20), barmerge.gaps_off, barmerge.lookahead_off)
dlyVolSma  = request.security(syminfo.tickerid, "D", ta.sma(volume, 20), barmerge.gaps_off, barmerge.lookahead_off)
dlyBbLo    = request.security(syminfo.tickerid, "D", f_dlyBbLo(), barmerge.gaps_off, barmerge.lookahead_off)
dlyBbMid   = request.security(syminfo.tickerid, "D", f_dlyBbMid(), barmerge.gaps_off, barmerge.lookahead_off)
dlyBbUp    = request.security(syminfo.tickerid, "D", f_dlyBbUp(), barmerge.gaps_off, barmerge.lookahead_off)
dlyClose   = request.security(syminfo.tickerid, "D", close, barmerge.gaps_off, barmerge.lookahead_off)
dlyLow     = request.security(syminfo.tickerid, "D", low, barmerge.gaps_off, barmerge.lookahead_off)
dlyHigh    = request.security(syminfo.tickerid, "D", high, barmerge.gaps_off, barmerge.lookahead_off)
dlyVol     = request.security(syminfo.tickerid, "D", volume, barmerge.gaps_off, barmerge.lookahead_off)
dlyAtr     = request.security(syminfo.tickerid, "D", ta.atr(14), barmerge.gaps_off, barmerge.lookahead_off)
dlyAdx     = request.security(syminfo.tickerid, "D", f_wkAdx(14), barmerge.gaps_off, barmerge.lookahead_off)
dlyStochK  = request.security(syminfo.tickerid, "D", ta.sma(ta.stoch(close, high, low, 14), 3), barmerge.gaps_off, barmerge.lookahead_off)

// Daily archetype qualifications (using daily-level data)
// Trend Pullback — daily EMA21 touch + bounce + confirmations
dly_tp_long  = nz(dlyEma9) > nz(dlyEma21) and nz(dlyRsi) > 50 and nz(dlyMacdH) > 0 and nz(dlyClose) > nz(dlyEma21)
dly_tp_short = nz(dlyEma9) < nz(dlyEma21) and nz(dlyRsi) < 50 and nz(dlyMacdH) < 0 and nz(dlyClose) < nz(dlyEma21)

// Momentum Breakout — daily Donchian break + volume
dly_mb_long  = nz(dlyClose) > nz(dlyDonchHi[1]) and nz(dlyVol) > nz(dlyVolSma) * 1.5
dly_mb_short = nz(dlyClose) < nz(dlyDonchLo[1]) and nz(dlyVol) > nz(dlyVolSma) * 1.5

// Mean Reversion — daily BB touch or MACD flip
dly_mr_long  = (nz(dlyMacdH) > 0 and nz(dlyMacdH[1]) <= 0) or (nz(dlyLow) <= nz(dlyBbLo) and nz(dlyClose) > nz(dlyBbLo))
dly_mr_short = (nz(dlyMacdH) < 0 and nz(dlyMacdH[1]) >= 0) or (nz(dlyHigh) >= nz(dlyBbUp) and nz(dlyClose) < nz(dlyBbUp))

// Iron condor — daily ADX quiet
var int dlyAdxQuiet = 0
dlyAdxQuiet := nz(dlyAdx) < 20 ? dlyAdxQuiet + 1 : 0
dly_ic      = hasIronCondor and dlyAdxQuiet >= 10

// Route to correct archetype
dlyLongQualified  = rawArchId == 1 ? dly_tp_long : rawArchId == 2 ? dly_mb_long : dly_mr_long
dlyShortQualified = rawArchId == 1 ? dly_tp_short : rawArchId == 2 ? dly_mb_short : dly_mr_short


// ════════════════════════════════════════════════════════════════════════
// LAYER 3 — INTRADAY TIMING (native 4h/6h indicators)
// ════════════════════════════════════════════════════════════════════════

// Intraday indicators (standard periods — work well on 4h/6h)
iflyEma9   = ta.ema(close, 9)
iflyEma21  = ta.ema(close, 21)
iflyRsi    = ta.rsi(close, 14)
iflyAtr    = ta.atr(14)
[_il, _is, iflyMacdH] = ta.macd(close, 12, 26, 9)

// Intraday confirmation: aligned with daily signal direction
iflyLongOk  = iflyEma9 > iflyEma21 and iflyRsi > 45
iflyShortOk = iflyEma9 < iflyEma21 and iflyRsi < 55

// Session timing: only fire in PM session (after noon ET)
isAfternoon = not pmSessionOnly or hour(time, "America/New_York") >= 12

// Combined fire: daily qualification + intraday confirmation + session timing
finalLong  = dlyLongQualified and longAllowed and iflyLongOk and isAfternoon and barstate.isconfirmed
finalShort = dlyShortQualified and shortAllowed and iflyShortOk and isAfternoon and barstate.isconfirmed
finalIC    = dly_ic and isAfternoon and barstate.isconfirmed

// Indicator plots
plot(iflyEma9,  "EMA 9",  color=color.new(color.blue, 40), linewidth=1)
plot(iflyEma21, "EMA 21", color=color.new(color.orange, 40), linewidth=1)
regBG = isRegimeAdaptive ? (wkBullish ? color.new(color.green, 93) : color.new(color.red, 93)) : na
bgcolor(showRegimeBG and isRegimeAdaptive ? regBG : na, title="Regime BG")


// ════════════════════════════════════════════════════════════════════════
// CONVICTION SCORING
// ════════════════════════════════════════════════════════════════════════

ema200 = ta.ema(close, 200)
longScore  = finalLong ? (nz(dlyEma9) > nz(dlyEma21) ? 25.0 : 0.0) + (nz(dlyRsi) > 50 ? 25.0 : 0.0) + (close > ema200 ? 20.0 : 0.0) + (wkBullish ? 15.0 : 0.0) + (nz(dlyVol) > nz(dlyVolSma) ? 5.0 : 0.0) + (nz(dlyMacdH) > 0 ? 5.0 : 0.0) + (nz(dlyAdx) > 25 ? 5.0 : 0.0) : 0.0
shortScore = finalShort ? (nz(dlyEma9) < nz(dlyEma21) ? 25.0 : 0.0) + (nz(dlyRsi) < 50 ? 25.0 : 0.0) + (close < ema200 ? 20.0 : 0.0) + (wkBearish ? 15.0 : 0.0) + (nz(dlyVol) > nz(dlyVolSma) ? 5.0 : 0.0) + (nz(dlyMacdH) < 0 ? 5.0 : 0.0) + (nz(dlyAdx) > 25 ? 5.0 : 0.0) : 0.0
icScore    = finalIC ? (dlyAdxQuiet >= 10 ? 30.0 : 0.0) + (nz(dlyAdx) < 15 ? 20.0 : 0.0) + (math.abs(nz(dlyRsi) - 50) < 10 ? 15.0 : 0.0) + (nz(wkADX) < 25 ? 10.0 : 0.0) : 0.0

bestScore  = math.max(longScore, math.max(shortScore, icScore))
bestAction = longScore >= shortScore and longScore >= icScore and longScore > 0 ? "LONG" : shortScore >= icScore and shortScore > 0 ? "SHORT" : icScore > 0 ? "IRON_CONDOR" : "NONE"
hasSignal  = bestScore > 0 and bestAction != "NONE"


// ════════════════════════════════════════════════════════════════════════
// COOLDOWN + QUALITY FILTERS
// ════════════════════════════════════════════════════════════════════════

var int lastSignalBar = 0
var float lastSignalClose = 0.0
var bool swingCooldown = false

barCooldownOk = bar_index - lastSignalBar >= cooldownBars
pullbackOk    = not swingCooldown or (lastSignalClose > 0 and math.abs(close - lastSignalClose) / lastSignalClose > 0.02)
cooldownOk    = barCooldownOk and pullbackOk
scoreOk       = bestScore >= minScore
atrOk         = nz(dlyAtr) > 0 and (nz(dlyAtr) / close * 100) >= 0.8 and (nz(dlyAtr) / close * 100) <= 6.0

fireSignal    = hasSignal and scoreOk and cooldownOk and atrOk


// ════════════════════════════════════════════════════════════════════════
// EXIT SIGNALS
// ════════════════════════════════════════════════════════════════════════

var int entryBar     = 0
var bool inPosition  = false
var float entryRSI   = 0.0
var string posDir    = ""

exitEmaCheck         = posDir == "LONG" ? close < iflyEma9 : posDir == "SHORT" ? close > iflyEma9 : false
var int belowCount   = 0
belowCount          := exitEmaCheck ? belowCount + 1 : 0
exitStop             = inPosition and belowCount >= 2

exitMomentum         = inPosition and posDir == "LONG" and entryRSI > 60 and iflyRsi < 40
exitMomentumS        = inPosition and posDir == "SHORT" and entryRSI < 40 and iflyRsi > 60
exitTP               = inPosition and ((posDir == "LONG" and iflyRsi > rsiExitHi) or (posDir == "SHORT" and iflyRsi < (100 - rsiExitHi)))
barsInTrade          = inPosition ? bar_index - entryBar : 0
exitTime             = inPosition and barsInTrade >= maxHoldBars
timeWarning          = inPosition and barsInTrade >= timeWarnBar and barsInTrade < maxHoldBars

exitSignal           = exitStop or exitMomentum or exitMomentumS or exitTP or exitTime
exitReason           = exitStop ? "stop_loss" : exitMomentum or exitMomentumS ? "momentum_reversal" : exitTP ? "take_profit" : exitTime ? "time_stop" : ""

stopLevel   = fireSignal and bestAction == "LONG" ? close - atrStopMult * nz(dlyAtr) : fireSignal and bestAction == "SHORT" ? close + atrStopMult * nz(dlyAtr) : na
targetLevel = fireSignal and bestAction == "LONG" ? close + atrTargetMult * nz(dlyAtr) : fireSignal and bestAction == "SHORT" ? close - atrTargetMult * nz(dlyAtr) : na


// ════════════════════════════════════════════════════════════════════════
// POSITION TRACKING
// ════════════════════════════════════════════════════════════════════════

if fireSignal and (bestAction == "LONG" or bestAction == "SHORT")
    lastSignalBar   := bar_index
    lastSignalClose := close
    swingCooldown   := true
    entryBar        := bar_index
    entryRSI        := iflyRsi
    inPosition      := true
    belowCount      := 0
    posDir          := bestAction

if fireSignal and bestAction == "IRON_CONDOR"
    lastSignalBar   := bar_index
    lastSignalClose := close

if exitSignal
    inPosition      := false
    swingCooldown   := false
    entryBar        := 0
    belowCount      := 0
    posDir          := ""


// ════════════════════════════════════════════════════════════════════════
// VISUAL MARKERS
// ════════════════════════════════════════════════════════════════════════

plotshape(fireSignal and bestAction == "LONG", "Long Entry", shape.triangleup, location.belowbar, color=color.green, size=size.normal)
plotshape(fireSignal and bestAction == "SHORT", "Short Entry", shape.triangledown, location.abovebar, color=color.red, size=size.normal)
plotshape(fireSignal and bestAction == "IRON_CONDOR", "Iron Condor", shape.diamond, location.abovebar, color=color.blue, size=size.small)
plotshape(timeWarning, "Time Warning", shape.triangleup, location.belowbar, color=color.yellow, size=size.tiny)
plotshape(exitSignal, "Exit", shape.xcross, location.abovebar, color=color.red, size=size.small)


// ════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ════════════════════════════════════════════════════════════════════════

var tbl = table.new(position.top_right, 4, 10, border_color=color.gray, border_width=1, frame_color=color.gray, frame_width=2)
daysSince = bar_index - lastSignalBar

if barstate.islast and showDashboard
    table.cell(tbl, 0, 0, syminfo.ticker, bgcolor=color.black, text_color=color.white, text_size=size.normal)
    table.cell(tbl, 1, 0, "V2 Hybrid", bgcolor=color.navy, text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 2, 0, archName, bgcolor=color.navy, text_color=color.yellow, text_size=size.tiny)
    table.cell(tbl, 3, 0, dirName, bgcolor=color.navy, text_color=color.yellow, text_size=size.tiny)

    regClr = regimeState == "bull" ? color.green : regimeState == "bear" ? color.red : color.gray
    table.cell(tbl, 0, 1, "REGIME", bgcolor=color.maroon, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, regimeState, text_color=regClr, text_size=size.small)
    table.cell(tbl, 2, 1, "dADX=" + str.tostring(nz(dlyAdx), "#"), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 3, 1, isRegimeAdaptive ? "ADAPTIVE" : "FIXED", text_color=isRegimeAdaptive ? color.yellow : color.gray, text_size=size.tiny)

    table.cell(tbl, 0, 2, "DAILY", bgcolor=color.new(color.teal, 40), text_color=color.white, text_size=size.small)
    dlyQual = dlyLongQualified ? "LONG OK" : dlyShortQualified ? "SHORT OK" : "—"
    table.cell(tbl, 1, 2, dlyQual, text_color=dlyLongQualified or dlyShortQualified ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 2, 2, "dRSI=" + str.tostring(nz(dlyRsi), "0.#"), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 3, 2, "dMACD " + (nz(dlyMacdH) > 0 ? "+" : "-"), text_color=nz(dlyMacdH) > 0 ? color.green : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 3, "INTRADAY", bgcolor=color.new(color.purple, 50), text_color=color.white, text_size=size.small)
    iflyOk = iflyLongOk or iflyShortOk
    table.cell(tbl, 1, 3, iflyOk ? "CONFIRMED" : "WAIT", text_color=iflyOk ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 2, 3, "iRSI=" + str.tostring(iflyRsi, "0.#"), text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 3, 3, isAfternoon ? "PM" : "AM", text_color=isAfternoon ? color.green : color.gray, text_size=size.tiny)

    sigClr = fireSignal ? color.green : hasSignal ? color.yellow : color.gray
    table.cell(tbl, 0, 4, "SIGNAL", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4, fireSignal ? bestAction : hasSignal ? "BLOCKED" : "—", text_color=sigClr, text_size=size.small)
    table.cell(tbl, 2, 4, str.tostring(bestScore, "#"), text_color=bestScore >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 4, cooldownOk ? "CD OK" : "CD " + str.tostring(cooldownBars - (bar_index - lastSignalBar)), text_color=cooldownOk ? color.green : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 5, "TRADE", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 5, inPosition ? posDir + " " + str.tostring(barsInTrade) + "b" : "FLAT", text_color=inPosition ? color.yellow : color.gray, text_size=size.small)
    timeLeft = inPosition ? maxHoldBars - barsInTrade : 0
    table.cell(tbl, 2, 5, inPosition ? str.tostring(timeLeft) + " bars left" : "", text_color=timeLeft <= 5 ? color.red : color.white, text_size=size.tiny)
    table.cell(tbl, 3, 5, str.tostring(daysSince) + " bars ago", text_color=color.gray, text_size=size.tiny)

    table.cell(tbl, 0, 6, "", bgcolor=color.black)
    table.cell(tbl, 1, 6, "", bgcolor=color.black)
    table.cell(tbl, 2, 6, "", bgcolor=color.black)
    table.cell(tbl, 3, 6, "", bgcolor=color.black)

    table.cell(tbl, 0, 7, "RISK", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 7, "Stop " + str.tostring(atrStopMult, "0.#") + "x", text_color=color.orange, text_size=size.small)
    table.cell(tbl, 2, 7, "Tgt " + str.tostring(atrTargetMult, "0.#") + "x", text_color=color.green, text_size=size.small)
    table.cell(tbl, 3, 7, "dATR=" + str.tostring(nz(dlyAtr), "0.##"), text_color=color.white, text_size=size.tiny)

    table.cell(tbl, 0, 8, "IC", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 8, hasIronCondor ? (dly_ic ? "ACTIVE" : "WAIT") : "N/A", text_color=dly_ic and hasIronCondor ? color.blue : color.gray, text_size=size.small)
    table.cell(tbl, 2, 8, hasIronCondor ? "Quiet " + str.tostring(dlyAdxQuiet) + "d" : "", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 3, 8, "", text_size=size.tiny)

    metaWarn = isMeta ? "LOW CONVICTION" : ""
    table.cell(tbl, 0, 9, metaWarn, bgcolor=isMeta ? color.new(color.red, 60) : color.black, text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 1, 9, "", bgcolor=color.black)
    table.cell(tbl, 2, 9, "TF=" + timeframe.period, text_color=color.gray, text_size=size.tiny, bgcolor=color.black)
    table.cell(tbl, 3, 9, "v2.0", text_color=color.gray, text_size=size.tiny, bgcolor=color.black)


// ════════════════════════════════════════════════════════════════════════
// ALERTS
// ════════════════════════════════════════════════════════════════════════

alertcondition(fireSignal and bestAction == "LONG", title="Long Entry", message="SWING_OPT LONG on {{ticker}}")
alertcondition(fireSignal and bestAction == "SHORT", title="Short Entry", message="SWING_OPT SHORT on {{ticker}}")
alertcondition(fireSignal and bestAction == "IRON_CONDOR", title="Iron Condor", message="SWING_OPT IC on {{ticker}}")
alertcondition(exitSignal, title="Exit", message="SWING_OPT EXIT on {{ticker}}")

// Tier classification (from Model C backtest)
f_tier() =>
    t = syminfo.ticker
    t == "SLV" or t == "MSFT" or t == "TSLA" or t == "XLE" ? 1 : t == "AMD" or t == "SOFI" or t == "GLD" ? 2 : 3

f_modelCwr() =>
    t = syminfo.ticker
    t == "SLV" ? 55.0 : t == "XLE" ? 52.0 : t == "MSFT" ? 50.0 : t == "TSLA" ? 49.0 : t == "AMD" ? 45.0 : t == "SOFI" ? 40.0 : t == "GLD" ? 38.0 : t == "IWM" ? 38.0 : t == "AMZN" ? 38.0 : t == "XLF" ? 36.0 : t == "INTC" ? 36.0 : t == "NVDA" ? 33.0 : t == "META" ? 31.0 : t == "QQQ" ? 28.0 : t == "SPY" ? 25.0 : 30.0

tickerTier = f_tier()
modelCwr   = f_modelCwr()
tierStr    = tickerTier == 1 ? "TIER1" : tickerTier == 2 ? "TIER2" : "TIER3"
spreadWidth = close > 100 ? "5.00" : "2.50"

if fireSignal and bestAction != "NONE"
    safeTicker = str.replace_all(syminfo.ticker, '"', '\\"')
    safeToken  = str.replace_all(webhookToken, '"', '\\"')
    payload = '{' + '"token":"' + safeToken + '",' + '"ticker":"' + safeTicker + '",' + '"action":"' + bestAction + '",' + '"archetype":"' + archName + '",' + '"conviction":' + str.tostring(bestScore, "0.#") + ',' + '"direction_mode":"' + dirName + '",' + '"regime_state":"' + regimeState + '",' + '"entry_price":' + str.tostring(close, "0.##") + ',' + '"stop_loss":' + str.tostring(nz(stopLevel, 0), "0.##") + ',' + '"target":' + str.tostring(nz(targetLevel, 0), "0.##") + ',' + '"daily_atr":' + str.tostring(nz(dlyAtr), "0.##") + ',' + '"daily_rsi":' + str.tostring(nz(dlyRsi), "0.#") + ',' + '"daily_adx":' + str.tostring(nz(dlyAdx), "0.#") + ',' + '"intraday_rsi":' + str.tostring(iflyRsi, "0.#") + ',' + '"suggested_dte":50,' + '"max_hold_bars":' + str.tostring(maxHoldBars) + ',' + '"options_structure":"vertical_debit_spread",' + '"take_profit_pct":50,' + '"stop_loss_pct":50,' + '"max_hold_days":15,' + '"spread_width":"' + spreadWidth + '",' + '"tier":"' + tierStr + '",' + '"model_c_expected_wr":' + str.tostring(modelCwr, "0.#") + ',' + '"management_rules":"TP at 50pct max profit, SL at 50pct max loss, close by day 15",' + '"timeframe":"' + timeframe.period + '",' + '"timestamp":"' + str.tostring(timenow) + '"}'
    alert(payload, alert.freq_once_per_bar_close)

if exitSignal
    safeTicker2 = str.replace_all(syminfo.ticker, '"', '\\"')
    safeToken2  = str.replace_all(webhookToken, '"', '\\"')
    exitPayload = '{' + '"token":"' + safeToken2 + '",' + '"ticker":"' + safeTicker2 + '",' + '"action":"EXIT",' + '"exit_reason":"' + exitReason + '",' + '"bars_in_trade":' + str.tostring(barsInTrade) + ',' + '"regime_state":"' + regimeState + '",' + '"intraday_rsi":' + str.tostring(iflyRsi, "0.#") + ',' + '"timestamp":"' + str.tostring(timenow) + '"}'
    alert(exitPayload, alert.freq_once_per_bar_close)