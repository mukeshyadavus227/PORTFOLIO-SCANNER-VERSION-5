//                strategyName, signalToString(direction),
//                str.tostring(confidence, "#.##"), str.tostring(regime))


// ============================================================================
// PLOTTING HELPERS
// ============================================================================

// Get color based on signal direction
// signalColor(signal) =>
//     signal == 1 ? color.green : signal == -1 ? color.red : color.gray

