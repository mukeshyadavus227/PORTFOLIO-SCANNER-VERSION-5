//@version=6
indicator("Portfolio Scanner v5 [Webhook]", overlay=true, max_labels_count=50)

// ============================================================================
// ADAPTIVE MULTI-STRATEGY PORTFOLIO SCANNER v5
// Production-grade scanner for watchlist deployment (42 symbols)
//
// ARCHITECTURE:
//   This indicator runs on EACH symbol in the watchlist independently.
//   When conviction score >= threshold, it fires a webhook alert to:
//     https://webhook.yadukul.us/webhook?token=<configured via input>
//   The signal aggregator collects signals from ALL symbols, ranks them
//   cross-sectionally, and Claude executes the top N picks.
//
// REGIME DETECTION:
//   3-axis classification: ADX (trend strength) x Choppiness (trending/choppy)
//   x BBW (volatility expansion/contraction)
//   -> TRENDING | BREAKOUT | MOMENTUM | MEAN_REVERT | NEUTRAL
//
// SUB-STRATEGIES:
//   S1: RSI Mean Reversion   (oversold bounce in uptrend)
//   S2: Donchian Breakout     (channel break + ADX + volume)
//   S3: EMA/VWAP Momentum    (EMA cross + VWAP + MACD)
//   S4: Multi-TF Trend        (weekly trend + daily pullback)
//
// CROSS-SECTIONAL FEATURES (sent to Claude):
//   - Relative volume percentile
//   - ATR percentile (volatility rank)
//   - Distance from 52-week high/low
//   - Rate of change rank
//   - Sector tag for correlation management
//
// DEPLOYMENT: Add to each chart in watchlist, create alert per symbol
//   Alert condition: "Any alert() function call"
//   Webhook URL: https://webhook.yadukul.us/webhook?token=<configured via input>
//   Message: {{alert.message}}  (uses alert_message from script)
// ============================================================================

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                         MASTER CONTROLS                                ║
// ╚══════════════════════════════════════════════════════════════════════════╝
minScore      = input.int(75, "Min Conviction Score", minval=30, maxval=90, step=5,
     group="Master Controls",
     tooltip="Minimum score to fire a webhook signal. 75=production, 60=loose, 85=strict")
shortEnabled  = input.bool(false, "Enable Short Signals",
     group="Master Controls")
useRegimeFilter = input.bool(true, "Enforce Regime-Strategy Alignment",
     group="Master Controls")
cooldownBars  = input.int(15, "Cooldown Bars After Signal", minval=1, maxval=50,
     group="Master Controls",
     tooltip="Prevent duplicate signals within N bars. 15=~3 weeks on daily")
webhookToken  = input.string("mukesh-tv-2026", "Webhook Token",
     group="Master Controls",
     tooltip="Authentication token sent in webhook payload. Change this to rotate credentials")
showRegimeBG  = input.bool(false, "Show Regime Background Colors",
     group="Display",
     tooltip="Color the chart background by regime. Off by default to reduce visual noise")
showStratLabel = input.bool(false, "Show Strategy Name on Signals",
     group="Display",
     tooltip="Show MR/BRK/MOM/MTF labels. Off = clean directional arrows only")

// Sector tag — SET THIS PER SYMBOL when deploying
sectorTag     = input.string("TECH", "Sector Tag",
     options=["INDEX","TECH","FINANCIAL","HEALTH","ENERGY","CONSUMER","INDUSTRIAL","STAPLES","COMMODITY","BOND"],
     group="Symbol Config",
     tooltip="Must match universe.json sector for this symbol")
assetClass    = input.string("STK", "Asset Class",
     options=["ETF","STK"],
     group="Symbol Config")
betaValue     = input.float(1.0, "Beta to SPY", minval=-1.0, maxval=3.0, step=0.05,
     group="Symbol Config",
     tooltip="Approximate beta. Used by Claude for portfolio beta targeting")

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                       REGIME DETECTION INPUTS                          ║
// ╚══════════════════════════════════════════════════════════════════════════╝
adxLen        = input.int(14, "ADX Length", minval=7, maxval=30,
     group="Regime Detection")
adxTrendThr   = input.int(25, "ADX Trending Threshold", minval=15, maxval=40,
     group="Regime Detection")
adxRangeThr   = input.int(20, "ADX Range-Bound Threshold", minval=10, maxval=25,
     group="Regime Detection")
chopLen       = input.int(14, "Choppiness Index Length", minval=5, maxval=30,
     group="Regime Detection")
bbwLen        = input.int(20, "BB Width Length", minval=10, maxval=50,
     group="Regime Detection")
bbwStd        = input.float(2.0, "BB Width StdDev", minval=1.0, maxval=3.0, step=0.5,
     group="Regime Detection")

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                    STRATEGY 1: RSI MEAN REVERSION                      ║
// ╚══════════════════════════════════════════════════════════════════════════╝
s1_rsiLen     = input.int(14, "S1: RSI Length", minval=2, maxval=50,
     group="S1: RSI Mean Reversion")
s1_oversold   = input.int(30, "S1: Oversold Level", minval=10, maxval=45,
     group="S1: RSI Mean Reversion")
s1_overbought = input.int(70, "S1: Overbought Level", minval=55, maxval=90,
     group="S1: RSI Mean Reversion")
s1_trendSMA   = input.int(200, "S1: Trend SMA", minval=50, maxval=300,
     group="S1: RSI Mean Reversion")

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                    STRATEGY 2: DONCHIAN BREAKOUT                       ║
// ╚══════════════════════════════════════════════════════════════════════════╝
s2_entryLen   = input.int(20, "S2: Entry Channel Length", minval=5, maxval=55,
     group="S2: Donchian Breakout")
s2_exitLen    = input.int(10, "S2: Exit Channel Length", minval=3, maxval=30,
     group="S2: Donchian Breakout")
s2_trendSMA   = input.int(50, "S2: Trend Filter SMA", minval=20, maxval=200,
     group="S2: Donchian Breakout")
s2_volMult    = input.float(1.3, "S2: Volume Spike Multiplier", minval=1.0, maxval=2.0, step=0.1,
     group="S2: Donchian Breakout")

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                   STRATEGY 3: EMA/VWAP MOMENTUM                        ║
// ╚══════════════════════════════════════════════════════════════════════════╝
s3_fastEMA    = input.int(9, "S3: Fast EMA", minval=3, maxval=30,
     group="S3: EMA/VWAP Momentum")
s3_slowEMA    = input.int(21, "S3: Slow EMA", minval=10, maxval=50,
     group="S3: EMA/VWAP Momentum")
s3_trendEMA   = input.int(50, "S3: Trend EMA", minval=30, maxval=200,
     group="S3: EMA/VWAP Momentum")
s3_macdFast   = input.int(12, "S3: MACD Fast", minval=5, maxval=20,
     group="S3: EMA/VWAP Momentum")
s3_macdSlow   = input.int(26, "S3: MACD Slow", minval=15, maxval=40,
     group="S3: EMA/VWAP Momentum")
s3_macdSig    = input.int(9, "S3: MACD Signal", minval=3, maxval=15,
     group="S3: EMA/VWAP Momentum")
s3_rsiMid     = input.int(50, "S3: RSI Midline", minval=40, maxval=60,
     group="S3: EMA/VWAP Momentum")

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                   STRATEGY 4: MULTI-TF TREND                           ║
// ╚══════════════════════════════════════════════════════════════════════════╝
s4_wkFast     = input.int(20, "S4: Weekly Fast EMA", minval=5, maxval=50,
     group="S4: Multi-TF Trend")
s4_wkSlow     = input.int(50, "S4: Weekly Slow EMA", minval=20, maxval=100,
     group="S4: Multi-TF Trend")
s4_dailyEMA   = input.int(21, "S4: Daily Entry EMA", minval=5, maxval=50,
     group="S4: Multi-TF Trend")
s4_rsiPBLo    = input.int(40, "S4: RSI Pullback Buy Zone", minval=25, maxval=50,
     group="S4: Multi-TF Trend")
s4_rsiPBHi    = input.int(60, "S4: RSI Pullback Sell Zone", minval=50, maxval=75,
     group="S4: Multi-TF Trend")

// ╔══════════════════════════════════════════════════════════════════════════╗
// ║                         RISK PARAMETERS                                ║
// ╚══════════════════════════════════════════════════════════════════════════╝
atrLen_risk   = input.int(14, "ATR Length (Risk)", minval=5, maxval=30,
     group="Risk Management")
riskBudget    = input.float(500.0, "Risk Budget per Trade ($)", minval=50, maxval=10000, step=50,
     group="Risk Management",
     tooltip="Dollar amount risked per trade. Used to calculate suggested share quantity")
minDollarVol  = input.float(5.0, "Min Avg Dollar Volume ($M)", minval=0.0, maxval=100.0, step=1.0,
     group="Risk Management",
     tooltip="Minimum 20-day average dollar volume in millions. Filters illiquid names. 0=disabled")

// ============================================================================
//                    CORE SHARED CALCULATIONS
// ============================================================================

atr           = ta.atr(atrLen_risk)
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxLen)
sma200        = ta.sma(close, 200)
rsi14         = ta.rsi(close, 14)
volSMA20      = ta.sma(volume, 20)

// --- Relative Volume Percentile (50-bar lookback) ---
// How today's volume compares to the last 50 bars
// Guard: skip bars where volSMA20 hasn't warmed up to avoid comparing ratio vs raw volume
relVol        = volSMA20 > 0 ? volume / volSMA20 : 1.0
rvPctile      = 50.0  // default
rvCount       = 0
rvValidBars   = 0
for i = 1 to 50
    if not na(volSMA20[i]) and volSMA20[i] > 0
        rvValidBars += 1
        if relVol > (volume[i] / volSMA20[i])
            rvCount += 1
rvPctile     := rvValidBars > 0 ? rvCount / rvValidBars * 100.0 : 50.0

// --- ATR Percentile (volatility rank vs last 252 bars ~ 1 year) ---
atrPctile     = 50.0
atrRankCount  = 0
for i = 1 to 252
    if not na(atr[i]) and atr > atr[i]
        atrRankCount += 1
atrPctile    := atrRankCount / 252.0 * 100.0

// --- 52-Week High/Low Distance ---
hi52          = ta.highest(high, 252)
lo52          = ta.lowest(low, 252)
range52       = hi52 - lo52
distFromHi    = range52 > 0 ? (hi52 - close) / range52 * 100.0 : 0.0  // 0 = at high, 100 = at low
distFromLo    = range52 > 0 ? (close - lo52) / range52 * 100.0 : 0.0  // 0 = at low, 100 = at high

// --- Rate of Change (momentum proxy) ---
roc20         = close[20] > 0 ? (close - close[20]) / close[20] * 100.0 : 0.0
roc60         = close[60] > 0 ? (close - close[60]) / close[60] * 100.0 : 0.0

// ============================================================================
//                        REGIME DETECTION
// ============================================================================

// Choppiness Index
chopATR       = math.sum(ta.tr, chopLen)
chopHL        = ta.highest(high, chopLen) - ta.lowest(low, chopLen)
chop          = chopHL != 0 ? 100.0 * math.log10(chopATR / chopHL) / math.log10(chopLen) : 50.0

// Bollinger Band Width
[bbMid, bbUp, bbLo] = ta.bb(close, bbwLen, bbwStd)
bbw           = bbMid != 0 ? (bbUp - bbLo) / bbMid * 100.0 : 0.0
bbwSMA        = ta.sma(bbw, 50)
bbwExpanding  = bbw > bbwSMA * 1.1
bbwContracting = bbw < bbwSMA * 0.9

// ATR expansion
atrSMA50      = ta.sma(atr, 50)
atrExpanding  = atr > atrSMA50 * 1.2

// Regime scoring (continuous, not just binary)
trendScore    = math.min((adxVal > adxTrendThr ? (adxVal - adxTrendThr) / 15.0 : 0.0) +
     (chop < 38.2 ? (38.2 - chop) / 20.0 : 0.0), 1.0) * 100.0
breakoutScore = math.min((atrExpanding ? 0.4 : 0.0) +
     (bbwExpanding ? 0.4 : 0.0) +
     (adxVal > adxRangeThr ? 0.2 : 0.0), 1.0) * 100.0
meanRevScore  = math.min((adxVal < adxRangeThr ? (adxRangeThr - adxVal) / 10.0 : 0.0) +
     (chop > 61.8 ? (chop - 61.8) / 20.0 : 0.0) +
     (bbwContracting ? 0.3 : 0.0), 1.0) * 100.0
momentumScore_regime = math.min((adxVal > adxRangeThr and adxVal <= adxTrendThr ? 0.5 : 0.0) +
     (not bbwContracting and not bbwExpanding ? 0.3 : 0.0) +
     (math.abs(roc20) > 3.0 ? 0.2 : 0.0), 1.0) * 100.0

// Dominant regime
regimeTrend   = trendScore >= 60
regimeBreakout = breakoutScore >= 60
regimeMeanRev = meanRevScore >= 60
regimeMomentum = momentumScore_regime >= 55 and not regimeBreakout and not regimeTrend and not regimeMeanRev

regime        = regimeBreakout ? 2 : regimeTrend ? 4 : regimeMomentum ? 3 : regimeMeanRev ? 1 : 0
regimeStr     = regime == 1 ? "MEAN_REV" : regime == 2 ? "BREAKOUT" : regime == 3 ? "MOMENTUM" : regime == 4 ? "TRENDING" : "NEUTRAL"
regimeConf    = regime == 1 ? meanRevScore : regime == 2 ? breakoutScore : regime == 3 ? momentumScore_regime : regime == 4 ? trendScore : 0.0

// Secondary regime: second-highest scoring regime (helps Claude understand dual-regime states)
regime2Score  = regime == 2 ? math.max(trendScore, math.max(momentumScore_regime, meanRevScore)) :
     regime == 4 ? math.max(breakoutScore, math.max(momentumScore_regime, meanRevScore)) :
     regime == 3 ? math.max(breakoutScore, math.max(trendScore, meanRevScore)) :
     regime == 1 ? math.max(breakoutScore, math.max(trendScore, momentumScore_regime)) :
     math.max(breakoutScore, math.max(trendScore, math.max(momentumScore_regime, meanRevScore)))
regime2Str    = regime2Score == trendScore and regime != 4 ? "TRENDING" :
     regime2Score == breakoutScore and regime != 2 ? "BREAKOUT" :
     regime2Score == momentumScore_regime and regime != 3 ? "MOMENTUM" :
     regime2Score == meanRevScore and regime != 1 ? "MEAN_REV" : "NEUTRAL"

// ============================================================================
//                    S1: RSI MEAN REVERSION SCORING
// ============================================================================
s1_rsi        = ta.rsi(close, s1_rsiLen)
s1_sma        = ta.sma(close, s1_trendSMA)
s1_wkTrend    = request.security(syminfo.tickerid, "W", ta.sma(close, 50))

// Graduated RSI scoring: deeper oversold = higher score
s1_rsiScore   = s1_rsi < s1_oversold - 10 ? 35.0 :
     s1_rsi < s1_oversold - 5 ? 30.0 :
     s1_rsi < s1_oversold ? 25.0 : 0.0  // removed edge zone (30-35) — require actual oversold
s1_rsiScoreShort = s1_rsi > s1_overbought + 10 ? 35.0 :
     s1_rsi > s1_overbought + 5 ? 30.0 :
     s1_rsi > s1_overbought ? 25.0 : 0.0  // removed edge zone (65-70) — too generous for short mean-rev

s1_trendUp    = close > nz(s1_wkTrend) and close > s1_sma
s1_trendDn    = close < nz(s1_wkTrend) and close < s1_sma
volAboveAvg   = volume > volSMA20 * 1.15

// Mean reversion scoring: deep oversold gets points even without uptrend
// The deeper the RSI, the less the trend filter matters (catching the bounce IS the trade)
s1_deepOversold = s1_rsi < s1_oversold - 5   // RSI < 25 = deeply oversold
s1_deepOverbought = s1_rsi > s1_overbought + 5  // RSI > 75 = deeply overbought

// Support proximity: price must be within 1.5 ATR of recent 20-bar low to catch bounces safely
s1_nearSupport  = close - ta.lowest(low, 20) < atr * 1.5
s1_nearResist   = ta.highest(high, 20) - close < atr * 1.5

s1_scoreLong  = s1_rsiScore +
     (s1_trendUp ? 25.0 : close > s1_sma ? 15.0 : (s1_deepOversold and s1_nearSupport) ? 12.0 : 0.0) +
     (volAboveAvg ? 15.0 : 0.0) +
     (distFromHi > 50 ? 10.0 : distFromHi > 30 ? 5.0 : 0.0) +   // near 52wk low = mean rev setup
     (regimeMeanRev ? 15.0 : regime == 0 ? 8.0 : 0.0)

s1_scoreShort = s1_rsiScoreShort +
     (s1_trendDn ? 25.0 : close < s1_sma ? 15.0 : (s1_deepOverbought and s1_nearResist) ? 12.0 : 0.0) +
     (volAboveAvg ? 15.0 : 0.0) +
     (distFromLo > 50 ? 10.0 : distFromLo > 30 ? 5.0 : 0.0) +
     (regimeMeanRev ? 15.0 : regime == 0 ? 8.0 : 0.0)

// ============================================================================
//                    S2: DONCHIAN BREAKOUT SCORING
// ============================================================================
s2_entryHigh  = ta.highest(high, s2_entryLen)
s2_entryLow   = ta.lowest(low, s2_entryLen)
s2_exitLow    = ta.lowest(low, s2_exitLen)
s2_exitHigh   = ta.highest(high, s2_exitLen)
s2_sma        = ta.sma(close, s2_trendSMA)
s2_volSpike   = volume > volSMA20 * s2_volMult

// Require CLOSE above/below channel — wicks alone produce too many false breakouts
s2_breakHigh  = close > s2_entryHigh[1]
s2_breakLow   = close < s2_entryLow[1]

// Extension filter: block breakouts when price is already stretched > 1.5 ATR beyond the trend SMA
// This prevents chasing — if the breakout is happening after a large move, it's late
s2_extendedUp   = close > s2_sma + atr * 1.5
s2_extendedDown = close < s2_sma - atr * 1.5

// Volume gate: breakout WITHOUT volume spike is not a real breakout — score = 0
s2_hasVolume    = s2_volSpike or volAboveAvg

s2_scoreLong  = (not s2_breakHigh or s2_extendedUp or not s2_hasVolume) ? 0.0 :
     30.0 +                                                             // breakout confirmed
     (close > s2_sma ? 15.0 : 0.0) +
     (adxVal > adxTrendThr ? 15.0 : adxVal > adxRangeThr ? 8.0 : 0.0) +
     (s2_volSpike ? 20.0 : 10.0) +                                     // already gated on volume
     (atrExpanding ? 5.0 : 0.0) +
     (regimeBreakout ? 15.0 : regime == 4 ? 8.0 : regime == 0 ? 5.0 : 0.0)

s2_scoreShort = (not s2_breakLow or s2_extendedDown or not s2_hasVolume) ? 0.0 :
     30.0 +
     (close < s2_sma ? 15.0 : 0.0) +
     (adxVal > adxTrendThr ? 15.0 : adxVal > adxRangeThr ? 8.0 : 0.0) +
     (s2_volSpike ? 20.0 : 10.0) +
     (atrExpanding ? 5.0 : 0.0) +
     (regimeBreakout ? 15.0 : regime == 4 ? 8.0 : regime == 0 ? 5.0 : 0.0)

// ============================================================================
//                   S3: EMA/VWAP MOMENTUM SCORING
// ============================================================================
s3_fast       = ta.ema(close, s3_fastEMA)
s3_slow       = ta.ema(close, s3_slowEMA)
s3_trend      = ta.ema(close, s3_trendEMA)
[s3_macdL, s3_sigL, s3_hist] = ta.macd(close, s3_macdFast, s3_macdSlow, s3_macdSig)
s3_crossUp    = ta.crossover(s3_fast, s3_slow)
s3_crossDown  = ta.crossunder(s3_fast, s3_slow)

// VWAP: only meaningful on intraday. On daily+, use volume-weighted MA as proxy
s3_anchor     = timeframe.isintraday ? ta.vwap(hlc3) : ta.vwma(close, 20)

// RSI extreme filter: don't chase momentum into oversold/overbought extremes
// Momentum LONG blocked when RSI > 70 (overbought = late), SHORT blocked when RSI < 30 (oversold = bounce likely)
s3_longBlocked  = rsi14 > 70
s3_shortBlocked = rsi14 < 30

// Recent crossover gate: require EMA cross within last 5 bars to prevent persistent-state scoring
s3_barsSinceCrossUp   = ta.barssince(s3_crossUp)
s3_barsSinceCrossDown = ta.barssince(s3_crossDown)
s3_recentCrossUp      = not na(s3_barsSinceCrossUp) and s3_barsSinceCrossUp <= 5
s3_recentCrossDown    = not na(s3_barsSinceCrossDown) and s3_barsSinceCrossDown <= 5

s3_scoreLong  = (s3_longBlocked or not s3_recentCrossUp) ? 0.0 :
     (s3_crossUp ? 25.0 : s3_fast > s3_slow ? 10.0 : 0.0) +
     (close > s3_anchor ? 15.0 : 0.0) +
     (close > s3_trend ? 12.0 : 0.0) +
     (s3_hist > 0 and rsi14 > s3_rsiMid ? 15.0 : s3_hist > 0 ? 8.0 : 0.0) +
     (volAboveAvg ? 10.0 : 0.0) +
     (roc20 > 3.0 ? 8.0 : 0.0) +
     (regimeMomentum ? 15.0 : regime == 4 ? 10.0 : regime == 2 ? 8.0 : regime == 0 ? 5.0 : 0.0)

s3_scoreShort = (s3_shortBlocked or not s3_recentCrossDown) ? 0.0 :
     (s3_crossDown ? 25.0 : s3_fast < s3_slow ? 10.0 : 0.0) +
     (close < s3_anchor ? 15.0 : 0.0) +
     (close < s3_trend ? 12.0 : 0.0) +
     (s3_hist < 0 and rsi14 < s3_rsiMid ? 15.0 : s3_hist < 0 ? 8.0 : 0.0) +
     (volAboveAvg ? 10.0 : 0.0) +
     (roc20 < -3.0 ? 8.0 : 0.0) +
     (regimeMomentum ? 15.0 : regime == 4 ? 10.0 : regime == 2 ? 8.0 : regime == 0 ? 5.0 : 0.0)

// ============================================================================
//                   S4: MULTI-TF TREND SCORING
// ============================================================================
// Helper: extract ADX value from ta.dmi() tuple for use inside request.security()
f_adx(int len) =>
    [p, m, a] = ta.dmi(len, len)
    a

s4_wkFastEMA  = request.security(syminfo.tickerid, "W", ta.ema(close, s4_wkFast))
s4_wkSlowEMA  = request.security(syminfo.tickerid, "W", ta.ema(close, s4_wkSlow))
s4_wkClose    = request.security(syminfo.tickerid, "W", close)
s4_wkADX      = request.security(syminfo.tickerid, "W", f_adx(14))
s4_dEMA       = ta.ema(close, s4_dailyEMA)
[s4_macdL, s4_sigL, s4_hist] = ta.macd(close, 12, 26, 9)

s4_wkBull     = nz(s4_wkFastEMA) > nz(s4_wkSlowEMA) and nz(s4_wkClose) > nz(s4_wkFastEMA)
s4_wkBear     = nz(s4_wkFastEMA) < nz(s4_wkSlowEMA) and nz(s4_wkClose) < nz(s4_wkFastEMA)
s4_wkStrong   = nz(s4_wkADX) > 20

s4_pullbackBuy  = rsi14 < s4_rsiPBLo and rsi14 > 25
s4_emaBounce    = close > s4_dEMA and close[1] <= s4_dEMA[1]
s4_pullbackSell = rsi14 > s4_rsiPBHi and rsi14 < 75
s4_emaReject    = close < s4_dEMA and close[1] >= s4_dEMA[1]

// Pullback entry gate: require at least one daily entry trigger — prevents firing at extended tops/bottoms
s4_hasLongEntry   = s4_pullbackBuy or s4_emaBounce
s4_hasShortEntry  = s4_pullbackSell or s4_emaReject

s4_scoreLong  = not s4_hasLongEntry ? 0.0 :
     (s4_wkBull ? 25.0 : 0.0) +
     (s4_wkStrong ? 10.0 : 0.0) +
     (s4_pullbackBuy ? 20.0 : s4_emaBounce ? 15.0 : 0.0) +
     (s4_macdL > s4_sigL ? 8.0 : 0.0) +
     (close > sma200 ? 8.0 : 0.0) +
     (volAboveAvg ? 7.0 : 0.0) +
     (roc60 > 5.0 ? 7.0 : 0.0) +                // 3-month trend confirmation
     (regimeTrend ? 15.0 : regime == 3 ? 10.0 : regime == 0 ? 5.0 : 0.0)

s4_scoreShort = not s4_hasShortEntry ? 0.0 :
     (s4_wkBear ? 25.0 : 0.0) +
     (s4_wkStrong ? 10.0 : 0.0) +
     (s4_pullbackSell ? 20.0 : s4_emaReject ? 15.0 : 0.0) +
     (s4_macdL < s4_sigL ? 8.0 : 0.0) +
     (close < sma200 ? 8.0 : 0.0) +
     (volAboveAvg ? 7.0 : 0.0) +
     (roc60 < -5.0 ? 7.0 : 0.0) +
     (regimeTrend ? 15.0 : regime == 3 ? 10.0 : regime == 0 ? 5.0 : 0.0)

// ============================================================================
//                    WINNER SELECTION ENGINE
// ============================================================================

// Regime-strategy alignment (tightened: only primary regime + NEUTRAL)
s1_aligned    = useRegimeFilter ? (regime == 1 or regime == 0) : true                    // MEAN_REV + NEUTRAL only
s2_aligned    = useRegimeFilter ? (regime == 2 or regime == 4 or regime == 0) : true     // BREAKOUT + TRENDING + NEUTRAL
s3_aligned    = useRegimeFilter ? (regime == 3 or regime == 4 or regime == 0) : true     // MOMENTUM + TRENDING + NEUTRAL
s4_aligned    = useRegimeFilter ? (regime == 4 or regime == 0) : true                    // TRENDING + NEUTRAL only

// Apply alignment: zero out misaligned
s1_fL = s1_aligned ? s1_scoreLong : 0.0
s2_fL = s2_aligned ? s2_scoreLong : 0.0
s3_fL = s3_aligned ? s3_scoreLong : 0.0
s4_fL = s4_aligned ? s4_scoreLong : 0.0
s1_fS = s1_aligned ? s1_scoreShort : 0.0
s2_fS = s2_aligned ? s2_scoreShort : 0.0
s3_fS = s3_aligned ? s3_scoreShort : 0.0
s4_fS = s4_aligned ? s4_scoreShort : 0.0

// Tie-breaking: on equal scores, priority order is S1 > S2 > S3 > S4 (mean-rev bias)
// Best long
bestLongScore = math.max(s1_fL, math.max(s2_fL, math.max(s3_fL, s4_fL)))
bestLongStrat = bestLongScore == s1_fL and s1_fL > 0 ? 1 :
     bestLongScore == s2_fL and s2_fL > 0 ? 2 :
     bestLongScore == s3_fL and s3_fL > 0 ? 3 :
     bestLongScore == s4_fL and s4_fL > 0 ? 4 : 0

// Best short
bestShortScore = math.max(s1_fS, math.max(s2_fS, math.max(s3_fS, s4_fS)))
bestShortStrat = bestShortScore == s1_fS and s1_fS > 0 ? 1 :
     bestShortScore == s2_fS and s2_fS > 0 ? 2 :
     bestShortScore == s3_fS and s3_fS > 0 ? 3 :
     bestShortScore == s4_fS and s4_fS > 0 ? 4 : 0

// Overall best
bestScore     = math.max(bestLongScore, bestShortScore)
bestStrat     = bestLongScore >= bestShortScore ? bestLongStrat : bestShortStrat
bestDir       = bestLongScore >= bestShortScore ? "BUY" : "SELL"
bestDirOk     = bestDir == "BUY" or (bestDir == "SELL" and shortEnabled)

// Strategy name lookups
stratName(_id) =>
    _id == 1 ? "RSI_MeanReversion" : _id == 2 ? "Donchian_Breakout" : _id == 3 ? "EMA_VWAP_Momentum" : _id == 4 ? "MultiTF_Trend" : "None"
stratLabel(_id) =>
    _id == 1 ? "MR" : _id == 2 ? "BRK" : _id == 3 ? "MOM" : _id == 4 ? "MTF" : "?"

// Cooldown
var int lastSignalBar = 0
cooldownOk    = bar_index - lastSignalBar >= cooldownBars

// ============================================================================
//                    SIGNAL GENERATION & WEBHOOK
// ============================================================================

// Liquidity filter: average dollar volume must exceed threshold
avgDollarVol  = volSMA20 * close  // 20-day average dollar volume
liquidityOk   = minDollarVol <= 0 or (avgDollarVol >= minDollarVol * 1000000.0)

// Fire conditions
fireSignal    = barstate.isconfirmed and bestScore >= minScore and bestStrat > 0 and bestDirOk and cooldownOk and liquidityOk

// Composite score: weighted blend for cross-sectional ranking
// Higher = more attractive for portfolio selection
// Strategy-aware: S1 mean-rev rewards proximity to 52wk low; others reward proximity to 52wk high
dist52wkComponent = bestStrat == 1 ? distFromHi : distFromLo  // S1 wants near low, others want near high
compositeScore = bestScore * 0.50 +                           // conviction weight
     regimeConf * 0.20 +                                      // regime confidence
     rvPctile * 0.15 +                                        // relative volume
     (100.0 - atrPctile) * 0.05 +                             // prefer lower vol (safer)
     dist52wkComponent * 0.10                                  // strategy-aware 52wk distance

// Strategy-specific stop distances — surgical, not one-size-fits-all
// S1 Mean Reversion: tight stop below recent swing low (1.2 ATR) — thesis invalidated fast
// S2 Breakout: stop just below the breakout channel level
// S3 Momentum: moderate stop (1.8 ATR) — give trend room but not too much
// S4 MTF Trend: widest stop (2.5 ATR) — weekly trends need breathing room
s1_stop       = atr * 1.2
s1_tp         = atr * 2.5            // 2:1 R:R for mean reversion
s2_stopLong   = math.max(atr * 0.8, math.abs(close - s2_entryHigh[1]) + atr * 0.3)  // below breakout high + cushion
s2_stopShort  = math.max(atr * 0.8, math.abs(s2_entryLow[1] - close) + atr * 0.3)  // above breakout low + cushion
s2_stop       = bestDir == "BUY" ? s2_stopLong : s2_stopShort
s2_tp         = atr * 3.0            // breakouts run — wider TP
s3_stop       = atr * 1.8
s3_tp         = atr * 3.0            // 1.7:1 R:R
s4_stop       = atr * 2.5
s4_tp         = atr * 4.0            // 1.6:1 R:R for trend trades

// Select stop/TP based on winning strategy
suggestedStop = bestStrat == 1 ? s1_stop : bestStrat == 2 ? s2_stop : bestStrat == 3 ? s3_stop : s4_stop
suggestedTP   = bestStrat == 1 ? s1_tp : bestStrat == 2 ? s2_tp : bestStrat == 3 ? s3_tp : s4_tp

// Actual price levels for bracket orders (Claude needs these, not just distances)
stopPriceLong  = close - suggestedStop
tpPriceLong    = close + suggestedTP
stopPriceShort = close + suggestedStop
tpPriceShort   = close - suggestedTP
stopPrice      = bestDir == "BUY" ? stopPriceLong : stopPriceShort
tpPrice        = bestDir == "BUY" ? tpPriceLong : tpPriceShort
rrRatio        = suggestedStop > 0 ? suggestedTP / suggestedStop : 0.0
suggestedQty   = suggestedStop > 0 ? math.max(1, math.round(riskBudget / suggestedStop)) : 1

// ── BUILD WEBHOOK JSON ──────────────────────────────────────────────────────
// This payload gives Claude everything for cross-sectional portfolio decisions

// Sanitize dynamic strings to prevent malformed JSON
safeToken     = str.replace_all(webhookToken, '"', '\\"')
safeTicker    = str.replace_all(syminfo.ticker, '"', '\\"')

webhookMsg    = '{' +
     '"token":"' + safeToken + '",' +
     '"symbol":"' + safeTicker + '",' +
     '"action":"' + bestDir + '",' +
     '"qty":' + str.tostring(suggestedQty) + ',' +
     '"sec_type":"' + assetClass + '",' +
     '"order_type":"LMT",' +
     '"strategy":"' + stratName(bestStrat) + '",' +
     '"sector":"' + sectorTag + '",' +
     '"asset_class":"' + assetClass + '",' +
     '"beta":' + str.tostring(betaValue, "0.##") + ',' +
     '"scores":{' +
         '"conviction":' + str.tostring(bestScore, "0.#") + ',' +
         '"composite":' + str.tostring(compositeScore, "0.#") + ',' +
         '"s1":' + str.tostring(math.max(s1_scoreLong, s1_scoreShort), "0.#") + ',' +
         '"s2":' + str.tostring(math.max(s2_scoreLong, s2_scoreShort), "0.#") + ',' +
         '"s3":' + str.tostring(math.max(s3_scoreLong, s3_scoreShort), "0.#") + ',' +
         '"s4":' + str.tostring(math.max(s4_scoreLong, s4_scoreShort), "0.#") +
     '},' +
     '"regime":{' +
         '"label":"' + regimeStr + '",' +
         '"confidence":' + str.tostring(regimeConf, "0.#") + ',' +
         '"trend_score":' + str.tostring(trendScore, "0.#") + ',' +
         '"breakout_score":' + str.tostring(breakoutScore, "0.#") + ',' +
         '"meanrev_score":' + str.tostring(meanRevScore, "0.#") + ',' +
         '"momentum_score":' + str.tostring(momentumScore_regime, "0.#") + ',' +
         '"secondary":"' + regime2Str + '",' +
         '"secondary_score":' + str.tostring(regime2Score, "0.#") +
     '},' +
     '"technicals":{' +
         '"rsi":' + str.tostring(rsi14, "0.#") + ',' +
         '"adx":' + str.tostring(adxVal, "0.#") + ',' +
         '"di_plus":' + str.tostring(diPlus, "0.#") + ',' +
         '"di_minus":' + str.tostring(diMinus, "0.#") + ',' +
         '"chop":' + str.tostring(chop, "0.#") + ',' +
         '"atr":' + str.tostring(atr, "0.##") + ',' +
         '"atr_pctile":' + str.tostring(atrPctile, "0.#") + ',' +
         '"rel_vol_pctile":' + str.tostring(rvPctile, "0.#") + ',' +
         '"roc_20d":' + str.tostring(roc20, "0.##") + ',' +
         '"roc_60d":' + str.tostring(roc60, "0.##") + ',' +
         '"dist_52wk_hi":' + str.tostring(distFromHi, "0.#") + ',' +
         '"dist_52wk_lo":' + str.tostring(distFromLo, "0.#") +
     '},' +
     '"risk":{' +
         '"stop_distance":' + str.tostring(suggestedStop, "0.##") + ',' +
         '"tp_distance":' + str.tostring(suggestedTP, "0.##") + ',' +
         '"stop_price":' + str.tostring(stopPrice, "0.##") + ',' +
         '"tp_price":' + str.tostring(tpPrice, "0.##") + ',' +
         '"stop_pct":' + str.tostring(close > 0 ? suggestedStop / close * 100.0 : 0.0, "0.##") + ',' +
         '"rr_ratio":' + str.tostring(rrRatio, "0.##") +
     '},' +
     '"price":' + str.tostring(close, "0.##") + ',' +
     '"bar_time":' + str.tostring(time) + ',' +
     '"timeframe":"' + timeframe.period + '",' +
     '"comment":"SCANNER_V5 | ' + stratLabel(bestStrat) + ' ' + str.tostring(bestScore, "#") +
         ' | regime=' + regimeStr +
         ' | comp=' + str.tostring(compositeScore, "#") +
         ' | rvol=' + str.tostring(rvPctile, "#") + 'pct"' +
     '}'

// Fire alert
if fireSignal
    lastSignalBar := bar_index
    alert(webhookMsg, alert.freq_once_per_bar_close)


// ============================================================================
//                         VISUALIZATION
// ============================================================================

// ── ENTRY PRICE TRACKING + STOP/TP LINES ──────────────────────────────────
// Persist the last signal's entry, stop, and TP levels for visual reference
var float entryPrice  = na
var float slLevel     = na
var float tpLevel     = na
var int   entryDir    = 0    // 1 = long, -1 = short, 0 = flat
var line  entryLine   = na
var line  slLine      = na
var line  tpLine      = na
var label entryLbl    = na
var label slLbl       = na
var label tpLbl       = na

// On new entry signal: update levels and draw lines
if fireSignal
    entryPrice := close
    entryDir   := bestDir == "BUY" ? 1 : -1
    slLevel    := stopPrice
    tpLevel    := tpPrice

    // Remove old lines/labels
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(entryLbl)
        label.delete(entryLbl)
    if not na(slLbl)
        label.delete(slLbl)
    if not na(tpLbl)
        label.delete(tpLbl)

    // Draw new lines extending right
    entryLine := line.new(bar_index, entryPrice, bar_index + 20, entryPrice,
         color=color.white, width=1, style=line.style_dotted)
    slLine    := line.new(bar_index, slLevel, bar_index + 20, slLevel,
         color=color.red, width=2, style=line.style_solid)
    tpLine    := line.new(bar_index, tpLevel, bar_index + 20, tpLevel,
         color=color.green, width=2, style=line.style_solid)

    // Labels at line endpoints
    entryLbl  := label.new(bar_index + 21, entryPrice, "Entry " + str.tostring(entryPrice, "0.##"),
         color=color.new(color.white, 80), textcolor=color.white, style=label.style_label_left, size=size.tiny)
    slLbl     := label.new(bar_index + 21, slLevel, "SL " + str.tostring(slLevel, "0.##"),
         color=color.new(color.red, 80), textcolor=color.red, style=label.style_label_left, size=size.tiny)
    tpLbl     := label.new(bar_index + 21, tpLevel, "TP " + str.tostring(tpLevel, "0.##") + " (R:R " + str.tostring(rrRatio, "0.#") + ")",
         color=color.new(color.green, 80), textcolor=color.green, style=label.style_label_left, size=size.tiny)


// ── POSITION AUTO-CLOSE: reset when SL or TP is hit ──────────────────────
// Detects when price breaches stop-loss or take-profit levels, then clears position tracking
slHitLong     = entryDir == 1 and not na(slLevel) and low <= slLevel
tpHitLong     = entryDir == 1 and not na(tpLevel) and high >= tpLevel
slHitShort    = entryDir == -1 and not na(slLevel) and high >= slLevel
tpHitShort    = entryDir == -1 and not na(tpLevel) and low <= tpLevel
positionClosed = slHitLong or tpHitLong or slHitShort or tpHitShort

if positionClosed
    entryDir   := 0
    entryPrice := na
    slLevel    := na
    tpLevel    := na
    if not na(entryLine)
        line.delete(entryLine)
    if not na(slLine)
        line.delete(slLine)
    if not na(tpLine)
        line.delete(tpLine)
    if not na(entryLbl)
        label.delete(entryLbl)
    if not na(slLbl)
        label.delete(slLbl)
    if not na(tpLbl)
        label.delete(tpLbl)

// ── PROJECTED STOP/TP PREVIEW (live bar, pre-confirmation) ────────────────
// Shows dashed preview lines when score qualifies but bar hasn't closed yet
// Lets you visually evaluate the trade BEFORE it fires
var line  prevSLLine  = na
var line  prevTPLine  = na
var line  prevEntLine = na
var label prevSLLbl   = na
var label prevTPLbl   = na
var label prevEntLbl  = na

// Clean up previous preview lines every bar
if not na(prevSLLine)
    line.delete(prevSLLine)
if not na(prevTPLine)
    line.delete(prevTPLine)
if not na(prevEntLine)
    line.delete(prevEntLine)
if not na(prevSLLbl)
    label.delete(prevSLLbl)
if not na(prevTPLbl)
    label.delete(prevTPLbl)
if not na(prevEntLbl)
    label.delete(prevEntLbl)

// Draw preview only when: score qualifies, no existing position, bar not yet confirmed
previewOk = bestScore >= minScore and bestStrat > 0 and bestDirOk and cooldownOk and entryDir == 0 and not barstate.isconfirmed
if previewOk
    prevEntLine := line.new(bar_index, close, bar_index + 15, close,
         color=color.new(color.white, 50), width=1, style=line.style_dashed)
    prevSLLine  := line.new(bar_index, stopPrice, bar_index + 15, stopPrice,
         color=color.new(color.red, 50), width=1, style=line.style_dashed)
    prevTPLine  := line.new(bar_index, tpPrice, bar_index + 15, tpPrice,
         color=color.new(color.green, 50), width=1, style=line.style_dashed)
    prevEntLbl  := label.new(bar_index + 16, close, "~ Entry " + str.tostring(close, "0.##"),
         color=color.new(color.white, 90), textcolor=color.new(color.white, 30), style=label.style_label_left, size=size.tiny)
    prevSLLbl   := label.new(bar_index + 16, stopPrice, "~ SL " + str.tostring(stopPrice, "0.##"),
         color=color.new(color.red, 90), textcolor=color.new(color.red, 30), style=label.style_label_left, size=size.tiny)
    prevTPLbl   := label.new(bar_index + 16, tpPrice, "~ TP " + str.tostring(tpPrice, "0.##") + " (R:R " + str.tostring(rrRatio, "0.#") + ")",
         color=color.new(color.green, 90), textcolor=color.new(color.green, 30), style=label.style_label_left, size=size.tiny)

// Key levels
plot(sma200, "SMA 200", color=color.gray, linewidth=1)
plot(s3_fast, "EMA Fast", color=color.new(color.blue, 40), linewidth=1)
plot(s3_slow, "EMA Slow", color=color.new(color.orange, 40), linewidth=1)
plot(s2_entryHigh, "DC High", color=color.new(color.green, 70), linewidth=1)
plot(s2_entryLow, "DC Low", color=color.new(color.red, 70), linewidth=1)

// ── CLEAN MODE: directional arrows only ─────────────────────────────────────
plotshape(fireSignal and bestDir == "BUY" and not showStratLabel, "Long Entry",
     shape.triangleup, location.belowbar, color=color.green, size=size.small)
plotshape(fireSignal and bestDir == "SELL" and not showStratLabel, "Short Entry",
     shape.triangledown, location.abovebar, color=color.red, size=size.small)

// ── VERBOSE MODE: strategy name labels ──────────────────────────────────────
plotshape(fireSignal and bestDir == "BUY" and bestStrat == 1 and showStratLabel, "MR Buy",
     shape.labelup, location.belowbar, color=color.green, text="MR", textcolor=color.white, size=size.small)
plotshape(fireSignal and bestDir == "BUY" and bestStrat == 2 and showStratLabel, "BRK Buy",
     shape.labelup, location.belowbar, color=color.lime, text="BRK", textcolor=color.black, size=size.small)
plotshape(fireSignal and bestDir == "BUY" and bestStrat == 3 and showStratLabel, "MOM Buy",
     shape.labelup, location.belowbar, color=color.aqua, text="MOM", textcolor=color.black, size=size.small)
plotshape(fireSignal and bestDir == "BUY" and bestStrat == 4 and showStratLabel, "MTF Buy",
     shape.labelup, location.belowbar, color=color.teal, text="MTF", textcolor=color.white, size=size.small)
plotshape(fireSignal and bestDir == "SELL" and showStratLabel, "Short Verbose",
     shape.labeldown, location.abovebar, color=color.red, text="S", textcolor=color.white, size=size.small)

// Regime background (off by default — toggle via Display settings)
bgcolor(showRegimeBG ? (regime == 4 ? color.new(color.green, 96) :
     regime == 2 ? color.new(color.yellow, 95) :
     regime == 3 ? color.new(color.blue, 96) :
     regime == 1 ? color.new(color.purple, 96) :
     color.new(color.gray, 98)) : na, title="Regime BG")

// ============================================================================
//                       MASTER DASHBOARD
// ============================================================================
var tbl = table.new(position.top_right, 4, 14, border_color=color.gray, border_width=1,
     frame_color=color.gray, frame_width=2)

if barstate.islast
    // Header
    table.cell(tbl, 0, 0, syminfo.ticker, bgcolor=color.black, text_color=color.white, text_size=size.normal)
    table.cell(tbl, 1, 0, sectorTag, bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 2, 0, "Score", bgcolor=color.black, text_color=color.white, text_size=size.small)
    table.cell(tbl, 3, 0, "Status", bgcolor=color.black, text_color=color.white, text_size=size.small)

    // Regime
    regimeColor = regime == 4 ? color.green : regime == 2 ? color.yellow : regime == 3 ? color.blue : regime == 1 ? color.purple : color.gray
    table.cell(tbl, 0, 1, "REGIME", bgcolor=color.maroon, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, regimeStr, text_color=regimeColor, text_size=size.small)
    table.cell(tbl, 2, 1, str.tostring(regimeConf, "#"), text_color=regimeColor, text_size=size.small)
    table.cell(tbl, 3, 1, "ADX=" + str.tostring(adxVal, "#") + " CH=" + str.tostring(chop, "#"), text_color=color.white, text_size=size.tiny)

    // S1-S4 rows (show alignment-filtered scores, not raw)
    s1_b = math.max(s1_fL, s1_fS)
    s2_b = math.max(s2_fL, s2_fS)
    s3_b = math.max(s3_fL, s3_fS)
    s4_b = math.max(s4_fL, s4_fS)

    table.cell(tbl, 0, 2, "S1 MeanRev", bgcolor=color.new(color.purple, 50), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, s1_fL > s1_fS ? "LONG" : s1_fS > 0 ? "SHORT" : "—", text_color=s1_fL > s1_fS ? color.green : s1_fS > 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 2, 2, str.tostring(s1_b, "#"), text_color=s1_b >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 2, s1_aligned ? "OK" : "BLOCKED", text_color=s1_aligned ? color.green : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 3, "S2 Breakout", bgcolor=color.new(color.yellow, 50), text_color=color.black, text_size=size.small)
    table.cell(tbl, 1, 3, s2_fL > s2_fS ? "LONG" : s2_fS > 0 ? "SHORT" : "—", text_color=s2_fL > s2_fS ? color.green : s2_fS > 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 2, 3, str.tostring(s2_b, "#"), text_color=s2_b >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 3, s2_aligned ? "OK" : "BLOCKED", text_color=s2_aligned ? color.green : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 4, "S3 Momentum", bgcolor=color.new(color.blue, 50), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 4, s3_fL > s3_fS ? "LONG" : s3_fS > 0 ? "SHORT" : "—", text_color=s3_fL > s3_fS ? color.green : s3_fS > 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 2, 4, str.tostring(s3_b, "#"), text_color=s3_b >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 4, s3_aligned ? "OK" : "BLOCKED", text_color=s3_aligned ? color.green : color.red, text_size=size.tiny)

    table.cell(tbl, 0, 5, "S4 MTF Trend", bgcolor=color.new(color.teal, 50), text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 5, s4_fL > s4_fS ? "LONG" : s4_fS > 0 ? "SHORT" : "—", text_color=s4_fL > s4_fS ? color.green : s4_fS > 0 ? color.red : color.gray, text_size=size.small)
    table.cell(tbl, 2, 5, str.tostring(s4_b, "#"), text_color=s4_b >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 3, 5, s4_aligned ? "OK" : "BLOCKED", text_color=s4_aligned ? color.green : color.red, text_size=size.tiny)

    // Separator
    table.cell(tbl, 0, 6, "", bgcolor=color.black)
    table.cell(tbl, 1, 6, "", bgcolor=color.black)
    table.cell(tbl, 2, 6, "", bgcolor=color.black)
    table.cell(tbl, 3, 6, "", bgcolor=color.black)

    // Winner
    table.cell(tbl, 0, 7, "WINNER", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 7, stratLabel(bestStrat) + " " + bestDir, text_color=bestScore >= minScore ? color.green : color.gray, text_size=size.small)
    table.cell(tbl, 2, 7, str.tostring(bestScore, "#"), text_color=bestScore >= minScore ? color.green : color.red, text_size=size.small)
    table.cell(tbl, 3, 7, bestScore >= minScore and cooldownOk ? "FIRE" : "WAIT", text_color=bestScore >= minScore ? color.green : color.gray, text_size=size.small)

    // Composite score (what Claude uses for cross-sectional ranking)
    table.cell(tbl, 0, 8, "COMPOSITE", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 8, str.tostring(compositeScore, "0.#"), text_color=color.yellow, text_size=size.small)
    table.cell(tbl, 2, 8, "", text_size=size.small)
    table.cell(tbl, 3, 8, "cross-rank", text_color=color.gray, text_size=size.tiny)

    // Key metrics
    table.cell(tbl, 0, 9, "RSI", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 9, str.tostring(rsi14, "0.#"), text_color=rsi14 < 30 ? color.green : rsi14 > 70 ? color.red : color.white, text_size=size.small)
    table.cell(tbl, 2, 9, "rVol=" + str.tostring(rvPctile, "#") + "p", text_color=rvPctile > 70 ? color.green : color.gray, text_size=size.tiny)
    table.cell(tbl, 3, 9, "ATR=" + str.tostring(atrPctile, "#") + "p", text_color=color.white, text_size=size.tiny)

    table.cell(tbl, 0, 10, "52wk", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 10, str.tostring(distFromLo, "#") + "% from low", text_color=distFromLo > 80 ? color.green : distFromLo < 20 ? color.red : color.white, text_size=size.tiny)
    table.cell(tbl, 2, 10, "ROC20=" + str.tostring(roc20, "0.#") + "%", text_color=roc20 > 0 ? color.green : color.red, text_size=size.tiny)
    table.cell(tbl, 3, 10, "Beta=" + str.tostring(betaValue, "#.##"), text_color=color.white, text_size=size.tiny)

    // Risk — show actual price levels + R:R
    table.cell(tbl, 0, 11, "Risk", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 11, "SL $" + str.tostring(stopPrice, "0.##"), text_color=color.orange, text_size=size.tiny)
    table.cell(tbl, 2, 11, "TP $" + str.tostring(tpPrice, "0.##"), text_color=color.green, text_size=size.tiny)
    table.cell(tbl, 3, 11, "R:R " + str.tostring(rrRatio, "0.#") + " | " + str.tostring(close > 0 ? suggestedStop / close * 100.0 : 0.0, "0.#") + "%", text_color=rrRatio >= 2.0 ? color.green : rrRatio >= 1.5 ? color.yellow : color.red, text_size=size.tiny)

    // Position tracking
    posStr = entryDir == 1 ? "LONG @ " + str.tostring(entryPrice, "0.##") : entryDir == -1 ? "SHORT @ " + str.tostring(entryPrice, "0.##") : "FLAT"
    table.cell(tbl, 0, 12, "Position", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 12, posStr, text_color=entryDir == 1 ? color.green : entryDir == -1 ? color.red : color.gray, text_size=size.tiny)
    pnlPct = not na(entryPrice) and entryPrice > 0 ? (close - entryPrice) / entryPrice * 100.0 * entryDir : 0.0
    table.cell(tbl, 2, 12, not na(entryPrice) ? str.tostring(pnlPct, "0.##") + "%" : "", text_color=pnlPct >= 0 ? color.green : color.red, text_size=size.tiny)
    table.cell(tbl, 3, 12, not na(entryPrice) ? (pnlPct >= 0 ? "+" : "") + str.tostring(close - entryPrice, "0.##") : "", text_color=pnlPct >= 0 ? color.green : color.red, text_size=size.tiny)

    // Signal count
    table.cell(tbl, 0, 13, "Cooldown", bgcolor=color.navy, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 13, cooldownOk ? "READY" : str.tostring(cooldownBars - (bar_index - lastSignalBar)) + " bars", text_color=cooldownOk ? color.green : color.orange, text_size=size.small)
    table.cell(tbl, 2, 13, "TF=" + timeframe.period, text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 3, 13, "v5.0", text_color=color.gray, text_size=size.tiny)